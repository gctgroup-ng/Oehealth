<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Radiology Study Access Rules -->
        <record id="oeh_medical_imaging_physician" model="ir.rule">
            <field name="name">Physicians: Own radiology studies only</field>
            <field name="model_id" ref="model_oeh_medical_imaging"/>
            <field name="domain_force">['|', ('requestor', '=', False), ('requestor.oeh_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician'))]"/>
        </record>


        <record id="oeh_medical_imaging_nurse" model="ir.rule">
            <field name="name">Nurses: Read-only access to radiology studies</field>
            <field name="model_id" ref="model_oeh_medical_imaging"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_nurse'))]"/>
        </record>

        <record id="oeh_medical_imaging_admin" model="ir.rule">
            <field name="name">Managers: Full access to all radiology studies</field>
            <field name="model_id" ref="model_oeh_medical_imaging"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_manager'))]"/>
        </record>

        <!-- Attachment Access Rules for Medical Files -->
        <record id="oeh_medical_imaging_attachment_physician" model="ir.rule">
            <field name="name">Medical attachments: Physicians see their files</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician'))]"/>
        </record>


        <record id="oeh_medical_imaging_attachment_manager" model="ir.rule">
            <field name="name">Medical attachments: Managers see all</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_manager'))]"/>
        </record>

        <!-- Image Processor Access Rules -->
        <record id="oeh_medical_image_processor_rule" model="ir.rule">
            <field name="name">Image processor: Access based on user role</field>
            <field name="model_id" ref="model_oeh_medical_image_processor"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician')), (4, ref('intarvas.group_oeh_medical_manager')), (4, ref('intarvas.group_oeh_medical_nurse'))]"/>
        </record>

        <!-- Menu Access Controls -->
        <record model='ir.ui.menu' id='oeh_medical_imaging_test_type_conf_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_manager')])]"/>
        </record>

        <record model='ir.ui.menu' id='oeh_medical_imaging_test_conf_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager'),ref('intarvas.group_oeh_medical_nurse')])]"/>
        </record>

        <record model='ir.ui.menu' id='oeh_medical_imagingtest_department_menu'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_manager')])]"/>
        </record>

        <!-- Additional Security: Restrict sensitive operations -->
        <record id="oeh_medical_imaging_delete_rule" model="ir.rule">
            <field name="name">Delete restriction: Only managers can delete completed studies</field>
            <field name="model_id" ref="model_oeh_medical_imaging"/>
            <field name="domain_force">[('state', 'in', ['Draft', 'Test In Progress'])]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician')), (4, ref('intarvas.group_oeh_medical_nurse'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
