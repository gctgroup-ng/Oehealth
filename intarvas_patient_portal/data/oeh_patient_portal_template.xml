<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
    <record id="oeh_email_template_patient_portal" model="mail.template">
        <field name="name">Patient Portal: Send by email</field>
        <field name="model_id" ref="intarvas.model_oeh_medical_patient"/>
        <field name="subject">Welcome to Your Patient Portal - {{object.name}}</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                <div style="background: linear-gradient(135deg, #4f46e5 0%, #8b5cf6 100%); padding: 30px; text-align: center;">
                    <h1 style="color: white; margin: 0; font-size: 24px;">🏥 Welcome to Your Patient Portal</h1>
                </div>
                
                <div style="padding: 30px; background-color: #f9fafb;">
                    <p style="margin: 0 0 20px 0; font-size: 16px; color: #374151;">
                        Dear <strong><t t-out="object.name or ''"/></strong>,
                    </p>
                    
                    <p style="margin: 0 0 20px 0; font-size: 14px; color: #4b5563;">
                        Your patient portal account has been activated! You now have secure online access to your medical information.
                    </p>
                    
                    <div style="background: white; border-radius: 12px; padding: 24px; margin: 20px 0; border-left: 4px solid #4f46e5;">
                        <h3 style="margin: 0 0 16px 0; color: #1f2937; font-size: 18px;">📋 Your Account Details</h3>
                        <p style="margin: 0 0 8px 0; color: #4b5563;"><strong>Patient ID:</strong> <t t-out="object.identification_code or 'n/a'"/></p>
                        <p style="margin: 0 0 8px 0; color: #4b5563;"><strong>Email:</strong> <t t-out="object.email or 'n/a'"/></p>
                        <p style="margin: 0 0 16px 0; color: #4b5563;"><strong>Temporary Password:</strong> <span style="background: #f3f4f6; padding: 4px 8px; border-radius: 4px; font-family: monospace;"><t t-esc="env.company.patient_account_password or 'Contact your healthcare provider'"/></span></p>
                        <p style="margin: 0; font-size: 12px; color: #9ca3af;"><em>Please change your password after first login for security.</em></p>
                    </div>
                    
                    <div style="background: white; border-radius: 12px; padding: 24px; margin: 20px 0;">
                        <h3 style="margin: 0 0 16px 0; color: #1f2937; font-size: 18px;">🌟 What You Can Do</h3>
                        <ul style="margin: 0; padding-left: 20px; color: #4b5563;">
                            <li style="margin-bottom: 8px;">📅 View and book appointments</li>
                            <li style="margin-bottom: 8px;">📋 Access your medical records</li>
                            <li style="margin-bottom: 8px;">🧪 View lab results</li>
                            <li style="margin-bottom: 8px;">👥 Manage family member information</li>
                            <li style="margin-bottom: 8px;">💬 Communicate with your healthcare team</li>
                            <li style="margin-bottom: 8px;">🔒 Control your privacy settings (GDPR compliant)</li>
                        </ul>
                    </div>
                    
                    <div style="margin: 32px 0px 32px 0px; text-align: center;">
                       <a t-att-href="object.patient_url or '#'"
                           style="background: linear-gradient(135deg, #4f46e5 0%, #8b5cf6 100%); padding: 16px 32px; text-decoration: none; color: #fff; border-radius: 8px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
                            🚀 Access Your Portal Now
                        </a>
                    </div>
                    
                    <div style="background: #fef3c7; border-radius: 8px; padding: 16px; margin: 20px 0; border-left: 4px solid #f59e0b;">
                        <p style="margin: 0; font-size: 14px; color: #92400e;"><strong>📞 Need Help?</strong> Contact our support team if you have any questions about accessing your portal.</p>
                    </div>
                    
                    <p style="margin: 20px 0 0 0; font-size: 12px; color: #9ca3af; text-align: center;">
                        This portal is GDPR compliant. You have full control over your data and privacy settings.
                    </p>
                </div>
            </div>
        </field>
        <!--                <field name="report_template" ref="action_oeh_medical_report_patient_prescriptions"/>-->
        <!--                <field name="report_name">${(object.name or '').replace('/','_')}</field>-->
        <!--                <field name="lang">${object.patient.partner_id.lang}</field>-->
        <!--                <field name="auto_delete" eval="True"/>-->
    </record>
    </data>
</odoo>
