"font-family: monospace;\"><t t-esc=\"request.env.company.patient_account_password\"/></span></p>\n"
"                        <p style=\"margin: 0; font-size: 12px; color: #9ca3af;\"><em>Please change your password after first login for security.</em></p>\n"
"                    </div>\n"
"                    \n"
"                    <div style=\"background: white; border-radius: 12px; padding: 24px; margin: 20px 0;\">\n"
"                        <h3 style=\"margin: 0 0 16px 0; color: #1f2937; font-size: 18px;\">🌟 What You Can Do</h3>\n"
"                        <ul style=\"margin: 0; padding-left: 20px; color: #4b5563;\">\n"
"                            <li style=\"margin-bottom: 8px;\">📅 View and book appointments</li>\n"
"                            <li style=\"margin-bottom: 8px;\">📋 Access your medical records</li>\n"
"                            <li style=\"margin-bottom: 8px;\">🧪 View lab results</li>\n"
"                            <li style=\"margin-bottom: 8px;\">👥 Manage family member information</li>\n"
"                            <li style=\"margin-bottom: 8px;\">💬 Communicate with your healthcare team</li>\n"
"                            <li style=\"margin-bottom: 8px;\">🔒 Control your privacy settings (GDPR compliant)</li>\n"
"                        </ul>\n"
"                    </div>\n"
"                    \n"
"                    <div style=\"margin: 32px 0px 32px 0px; text-align: center;\">\n"
"                       <a t-att-href=\"object.patient_url or '#'\" style=\"background: linear-gradient(135deg, #4f46e5 0%, #8b5cf6 100%); padding: 16px 32px; text-decoration: none; "
"color: #fff; border-radius: 8px; font-size: 16px; font-weight: 600; display: inline-block; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\">\n"
"                            🚀 Access Your Portal Now\n"
"                        </a>\n"
"                    </div>\n"
"                    \n"
"                    <div style=\"background: #fef3c7; border-radius: 8px; padding: 16px; margin: 20px 0; border-left: 4px solid #f59e0b;\">\n"
"                        <p style=\"margin: 0; font-size: 14px; color: #92400e;\"><strong>📞 Need Help?</strong> Contact our support team if you have any questions about accessing "
"your portal.</p>\n"
"                    </div>\n"
"                    \n"
"                    <p style=\"margin: 20px 0 0 0; font-size: 12px; color: #9ca3af; text-align: center;\">\n"
"                        This portal is GDPR compliant. You have full control over your data and privacy settings.\n"
"                    </p>\n"
"                </div>\n"
"                \n"
