"                    <div style=\"background: white; border-radius: 12px; padding: 24px; margin: 20px 0; border-left: 4px solid #4f46e5;\">\n"
"                        <h3 style=\"margin: 0 0 16px 0; color: #1f2937; font-size: 18px;\">📋 Your Account Details</h3>\n"
