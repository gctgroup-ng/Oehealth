<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Patient Portal Direct Button - No Template Inheritance -->
        <template id="portal_patient_portal_direct" name="Patient Portal Direct Entry">
            <div class="col-lg-6 col-xl-4 col-md-6 o_portal_docs">
                <a href="/patient/portal" class="list-group-item list-group-item-action d-flex align-items-center">
                    <div class="o_portal_navbar_section">
                        <i class="fa fa-user-md fa-2x me-3" style="color: #6c757d;"/>
                    </div>
                    <div class="flex-grow-1">
                        <strong>Patient Portal</strong>
                        <div class="text-muted small">Access your medical records, appointments, and health information</div>
                    </div>
                    <span class="badge bg-secondary ms-2">1</span>
                </a>
            </div>
        </template>

