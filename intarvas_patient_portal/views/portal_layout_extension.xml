        <!-- Add My Health Portal Button to Right Sidebar -->
        <template id="portal_my_health_portal_sidebar_button" name="My Health Portal Sidebar Button" inherit_id="portal.side_content" priority="50">
            <xpath expr="//a[@href='/my/account']" position="after">
                <!-- Only show for users who have an associated patient record -->
                <t t-if="request.env.user.partner_id and request.env['oeh.medical.patient'].sudo().search([('partner_id', '=', request.env.user.partner_id.id)], limit=1)">
                    <a role="button" href="/patient/portal" class="btn btn-primary p-2 mt-3 d-flex align-items-center">
                        <i class="fa fa-heartbeat me-2"/>
                        My Health Portal
                    </a>
                </t>
            </xpath>
        </template>
</odoo>