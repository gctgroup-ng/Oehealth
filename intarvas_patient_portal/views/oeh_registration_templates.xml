<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="post_health_center_organization" name="Post Health Center">
        <t t-call="website.layout">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md">
                        <img class="img img-responsive img-fluid mb32"
                                 src="/intarvas_patient_portal/static/img/UK-Recruitment-Agencies.jpg"
                                 style="width:100%; height:100%;"></img>
                        <div class="d-none d-sm-block d-none d-xs-block header-text httal htvam">
                            <h2 id="header_293" class="form-header"
                                data-component="header">Great companies are built with great people
                            </h2>
                            <input type="hidden" class="post_active" t-att-value="post_job_active"/>
                        </div>
                    </div>
                    <div class="col-md">
                        <form id="create_organization_form_id" action="/health/create_health_center/thankyou"
                          data-toggle="validator" method="post"
                          class="msform form-horizontal container-fluid mt32 hr_form"
                          enctype="multipart/form-data" >
                        <div class="form_border" style="padding:1em;">
                           <h3 style="margin-bottom:2em;">CREATE YOUR HEALTH CENTER</h3>
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <t t-set="states" t-value="request.env['res.country.state'].sudo().search([])"/>
                            <t t-set="countries" t-value="request.env['res.country'].sudo().search([])"/>
                            <div class="col-lg-12 col-lg-12">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group o_website_form_required_custom">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="name" class="control-label">Name
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <input type="text"
                                                           class="form-control o_website_form_input"
                                                           name="name"
                                                           required="" data-error="Please add health center name."/>
                                                    <div class="help-block with-errors"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group o_website_form_required_custom">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="health_center_type" class="control-label">Health Center Type
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <select class="form-control" name="health_center_type" id="health_center_type" required="">
                                                         <option value="Hospital">Hospital</option>
                                                        <option value="Multi-speciality Hospital">Multi-speciality Hospital</option>
                                                        <option value="Nursing Home">Nursing Home</option>
                                                        <option value="Clinic">Clinic</option>
                                                        <option value="Community Health Center">Community Health Center</option>
                                                        <option value="Military Medical Facility">Military Medical Facility</option>
                                                        <option value="Other">Other</option>
                                                    </select>
                                                    <div class="help-block with-errors"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="street" class="control-label">
                                                        Street
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <input type="text"
                                                           class="form-control"
                                                           name="street"
                                                           />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="form-group o_website_form_required_custom">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="city" class="control-label">
                                                        City
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <input type="text"
                                                           class="form-control"
                                                           name="city"
                                                           required=""
                                                           />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="zip" class="control-label">
                                                        Zip
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <input type="text"
                                                           class="form-control"
                                                           name="zip"/>
                                                </div>
                                            </div>
                                        </div>

                                        <!--<div class="form-group" t-if="len(states) > 0">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="state_id" class="control-label">
                                                        State
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <select class="form-control" name="state_id">
                                                         <t t-foreach="states" t-as="state">
                                                              <option t-attf-value="#{state.id}"><t t-esc="state.name"/></option>
                                                         </t>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>-->

                                        <div class="form-group" t-if="len(countries) > 0">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="country_id" class="control-label">
                                                        Country
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <select class="form-control" name="country_id" required="required">
                                                         <t t-foreach="countries" t-as="country">
                                                              <option t-attf-value="#{country.id}"><t t-esc="country.name"/></option>
                                                         </t>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group o_website_form_required_custom">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="notify_email" class="control-label">
                                                        Email
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <input type="email"
                                                           class="form-control"
                                                           name="notify_email"
                                                           data-error="Please enter valid Email address."
                                                           required=""/>
                                                    <div class="help-block with-errors"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group o_website_form_required_custom">
                                            <div class="row">
                                                <div class="col-lg-4 text-right">
                                                    <label for="image_1920" class="control-label">
                                                        Logo
                                                    </label>
                                                </div>
                                                <div class="col-lg-8">
                                                    <input type="file"
                                                           class="form-control"
                                                           name="image_1920"
                                                           data-error="Please enter valid logo picture."
                                                           accept=".jpeg,.jpg,.png,"
                                                           required="" style="padding-bottom: 33px;"/>
                                                    <div class="help-block with-errors"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group o_website_form_required_custom">
                                            <div class="row">

                                                <div class="col-lg-12 text-center">
                                                    <button class="btn btn-primary btn-lg o_website_form_send mb32 action-button"
                                                            style="width: auto;" type="submit">Get in touch
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="health_center_thankyou" name="Health Center Thank You">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <p></p>
                                <h1 class="text-center">Congratulations!</h1>
                                <p class="text-center">
                                    Your Health Center creation demand has been recorded successfully.
                                </p>
                            </div>
                        </div>
                        <div class="row" id="o_recruitment_thank_cta">
                            <div class="col-lg-12 text-center mt32 mb32">
                                In the meantime,
                                <h3 class="mt8 mb32">Look around on our website:</h3>
                                <a role="button" href="/" class="btn btn-primary btn-lg">Continue To Our Website</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

