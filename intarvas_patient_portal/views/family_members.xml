<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="family_members" name="Family Members">
        <t t-call="intarvas_patient_portal.patient_portal_layout">
            <t t-set="page_title" t-value="'Family Members'"/>
            
            <!-- Page Header with Gradient Background -->
            <div class="welcome-section mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="welcome-title">
                            <i class="fas fa-users me-3"></i>Family Members
                        </h1>
                        <p class="welcome-subtitle">Manage your family member information</p>
                    </div>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addFamilyMemberModal">
                        <i class="fas fa-plus me-2"></i>Add Family Member
                    </button>
                </div>
            </div>

            <!-- Success/Error Messages -->
            <t t-if="request.params.get('success') == 'family_member_added'">
                <div class="alert alert-success-gradient mb-4">
                    <i class="fas fa-check-circle me-2"></i>
                    Family member added successfully!
                </div>
            </t>
            
            <t t-if="request.params.get('success') == 'family_member_updated'">
                <div class="alert alert-success-gradient mb-4">
                    <i class="fas fa-check-circle me-2"></i>
                    Family member updated successfully!
                </div>
            </t>
            
            <t t-if="request.params.get('success') == 'family_member_deleted'">
                <div class="alert alert-success-gradient mb-4">
                    <i class="fas fa-check-circle me-2"></i>
                    Family member removed successfully!
                </div>
            </t>
            
            <t t-if="request.params.get('error')">
                <div class="alert alert-danger-gradient mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <t t-if="request.params.get('error') == 'name_required'">
                        Name is required to add a family member.
                    </t>
                    <t t-elif="request.params.get('error') == 'access_denied'">
                        You don't have permission to edit this family member.
                    </t>
                    <t t-elif="request.params.get('error') == 'invalid_id'">
                        Invalid family member ID.
                    </t>
                    <t t-elif="request.params.get('error') == 'missing_id'">
                        Missing family member ID for update.
                    </t>
                    <t t-elif="request.params.get('error') == 'update_failed'">
                        Failed to update family member.
                    </t>
                    <t t-elif="request.params.get('error') == 'delete_failed'">
                        Failed to delete family member.
                    </t>
                    <t t-else="">
                        An error occurred. Please try again.
                    </t>
                </div>
            </t>
            
            <div class="family-members-content">
                <t t-if="family_members">
                    <div class="row">
                        <t t-foreach="family_members" t-as="member">
                            <div class="col-md-6 mb-3">
                                <div class="action-card">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <h4 class="mb-0">
                                            <i class="fas fa-user me-2"></i>
                                            <t t-esc="member.name"/>
                                        </h4>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button">
                                                <i class="fas fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item edit-family-member" href="#" 
                                                       t-att-data-id="member.id"
                                                       t-att-data-name="member.name"
                                                       t-att-data-relation="member.relation"
                                                       t-att-data-age="member.age"
                                                       t-att-data-phone="member.contact_no"
                                                       t-att-data-email="member.email">
                                                        <i class="fas fa-edit me-2"></i>Edit
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-danger delete-family-member" href="#" 
                                                       t-att-data-id="member.id"
                                                       t-att-data-name="member.name">
                                                        <i class="fas fa-trash me-2"></i>Remove
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    
                                    <div class="family-member-details">
                                        <t t-if="member.relation">
                                            <div class="detail-item">
                                                <i class="fas fa-heart me-2"></i>
                                                <strong>Relation:</strong> <t t-esc="member.relation"/>
                                            </div>
                                        </t>
                                        <t t-if="member.age">
                                            <div class="detail-item">
                                                <i class="fas fa-birthday-cake me-2"></i>
                                                <strong>Age:</strong> <t t-esc="member.age"/> years
                                            </div>
                                        </t>
                                        <t t-if="member.contact_no">
                                            <div class="detail-item">
                                                <i class="fas fa-phone me-2"></i>
                                                <strong>Phone:</strong> <t t-esc="member.contact_no"/>
                                            </div>
                                        </t>
                                        <t t-if="member.email">
                                            <div class="detail-item">
                                                <i class="fas fa-envelope me-2"></i>
                                                <strong>Email:</strong> <t t-esc="member.email"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                
                <t t-if="not family_members">
                    <div class="text-center py-5">
                        <div class="action-icon mb-4 icon-4x-auto">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="text-center-mb-1">No Family Members Found</h3>
                        <p class="text-center-mb-2">You haven't added any family members yet.</p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addFamilyMemberModal">
                            <i class="fas fa-plus me-2"></i>Add Your First Family Member
                        </button>
                    </div>
                </t>
            </div>

            <!-- Add/Edit Family Member Modal -->
            <div class="modal fade" id="addFamilyMemberModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="familyMemberModalTitle">
                                <i class="fas fa-plus me-2"></i>Add Family Member
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form id="familyMemberForm" method="post" action="/patient/portal/family-members" 
                              onsubmit="console.log('Form submitted:', new FormData(this));">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="family_id" id="family_id"/>
                            <input type="hidden" name="action" id="form_action" value="add"/>
                            
                            <div class="modal-body">
                                <div class="row g-3">
                                    <div class="col-md-12">
                                        <label for="member_name" class="form-label">Full Name *</label>
                                        <input type="text" class="form-control patient-form-control" id="member_name" name="name" required="required"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="member_relation" class="form-label">Relation</label>
                                        <select class="form-control patient-form-control" id="member_relation" name="relation">
                                            <option value="">Select Relation</option>
                                            <option value="Father">Father</option>
                                            <option value="Mother">Mother</option>
                                            <option value="Spouse">Spouse</option>
                                            <option value="Son">Son</option>
                                            <option value="Daughter">Daughter</option>
                                            <option value="Brother">Brother</option>
                                            <option value="Sister">Sister</option>
                                            <option value="Grand Father">Grand Father</option>
                                            <option value="Grand Mother">Grand Mother</option>
                                            <option value="Uncle">Uncle</option>
                                            <option value="Aunt">Aunt</option>
                                            <option value="Cousin">Cousin</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="member_age" class="form-label">Age</label>
                                        <input type="number" class="form-control patient-form-control" id="member_age" name="age" min="0" max="120"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="member_phone" class="form-label">Phone Number</label>
                                        <input type="tel" class="form-control patient-form-control" id="member_phone" name="phone"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="member_email" class="form-label">Email Address</label>
                                        <input type="email" class="form-control patient-form-control" id="member_email" name="email"/>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary" id="submitButton">
                                    <i class="fas fa-save me-2"></i>Save Family Member
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Delete Confirmation Modal -->
            <div class="modal fade" id="deleteFamilyMemberModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="fas fa-exclamation-triangle me-2 text-warning"></i>Confirm Removal
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to remove <strong id="deleteMemberName"></strong> from your family members?</p>
                            <p class="text-muted">This action cannot be undone.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <form id="deleteForm" method="post" style="display: inline;">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="action" value="delete"/>
                                <input type="hidden" name="family_id" id="delete_family_id"/>
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-2"></i>Remove Family Member
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- JavaScript for Modal Handling -->
            <script type="text/javascript">
            <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    // Initialize Bootstrap dropdowns
                    if (typeof bootstrap !== 'undefined') {
                        // Initialize all dropdowns
                        var dropdownElements = document.querySelectorAll('.dropdown-toggle');
                        dropdownElements.forEach(function(element) {
                            new bootstrap.Dropdown(element);
                        });
                    } else if (typeof $ !== 'undefined') {
                        // Initialize jQuery dropdowns
                        $('.dropdown-toggle').dropdown();
                    }
                    
                    // Additional fallback: Handle dropdown toggles manually
                    document.addEventListener('click', function(e) {
                        if (e.target.closest('.dropdown-toggle')) {
                            e.preventDefault();
                            e.stopPropagation();
                            
                            var toggle = e.target.closest('.dropdown-toggle');
                            var dropdown = toggle.parentElement;
                            var menu = dropdown.querySelector('.dropdown-menu');
                            
                            console.log('Dropdown toggle clicked', toggle, menu);
                            
                            // Close all other dropdowns
                            document.querySelectorAll('.dropdown-menu').forEach(function(otherMenu) {
                                if (otherMenu !== menu) {
                                    otherMenu.style.display = 'none';
                                    otherMenu.classList.remove('show');
                                }
                            });
                            
                            // Toggle current dropdown
                            if (menu.style.display === 'block' || menu.classList.contains('show')) {
                                menu.style.display = 'none';
                                menu.classList.remove('show');
                            } else {
                                menu.style.display = 'block';
                                menu.classList.add('show');
                            }
                        } else if (!e.target.closest('.dropdown')) {
                            // Close all dropdowns when clicking outside
                            document.querySelectorAll('.dropdown-menu').forEach(function(menu) {
                                menu.style.display = 'none';
                                menu.classList.remove('show');
                            });
                        }
                    });
                    
                    // Check if Bootstrap is available, if not use jQuery
                    var showModal = function(modalId) {
                        if (typeof bootstrap !== 'undefined') {
                            var modal = new bootstrap.Modal(document.getElementById(modalId));
                            modal.show();
                        } else if (typeof $ !== 'undefined') {
                            $('#' + modalId).modal('show');
                        } else {
                            // Fallback: show modal manually
                            var modal = document.getElementById(modalId);
                            modal.style.display = 'block';
                            modal.classList.add('show');
                            document.body.classList.add('modal-open');
                        }
                    };
                    
                    var hideModal = function(modalId) {
                        if (typeof bootstrap !== 'undefined') {
                            var modal = bootstrap.Modal.getInstance(document.getElementById(modalId));
                            if (modal) modal.hide();
                        } else if (typeof $ !== 'undefined') {
                            $('#' + modalId).modal('hide');
                        } else {
                            // Fallback: hide modal manually
                            var modal = document.getElementById(modalId);
                            modal.style.display = 'none';
                            modal.classList.remove('show');
                            document.body.classList.remove('modal-open');
                        }
                    };
                    
                    // Use event delegation for edit family member
                    document.addEventListener('click', function(e) {
                        if (e.target.closest('.edit-family-member')) {
                            e.preventDefault();
                            var btn = e.target.closest('.edit-family-member');
                            var data = btn.dataset;
                            console.log('Edit button clicked', data);
                            
                            document.getElementById('familyMemberModalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Family Member';
                            document.getElementById('submitButton').innerHTML = '<i class="fas fa-save me-2"></i>Update Family Member';
                            document.getElementById('form_action').value = 'edit';
                            document.getElementById('family_id').value = data.id;
                            document.getElementById('member_name').value = data.name || '';
                            document.getElementById('member_relation').value = data.relation || '';
                            document.getElementById('member_age').value = data.age || '';
                            document.getElementById('member_phone').value = data.phone || '';
                            document.getElementById('member_email').value = data.email || '';
                            
                            showModal('addFamilyMemberModal');
                        }
                        
                        if (e.target.closest('.delete-family-member')) {
                            e.preventDefault();
                            var btn = e.target.closest('.delete-family-member');
                            var data = btn.dataset;
                            console.log('Delete button clicked', data);
                            
                            document.getElementById('deleteMemberName').textContent = data.name;
                            document.getElementById('delete_family_id').value = data.id;
                            document.getElementById('deleteForm').action = '/patient/portal/family-members';
                            
                            showModal('deleteFamilyMemberModal');
                        }
                    });
                    
                    // Close modal handlers
                    document.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function(btn) {
                        btn.addEventListener('click', function() {
                            var modal = this.closest('.modal');
                            if (modal) {
                                hideModal(modal.id);
                            }
                        });
                    });
                    
                    // Reset form when modal is closed
                    var resetForm = function() {
                        document.getElementById('familyMemberModalTitle').innerHTML = '<i class="fas fa-plus me-2"></i>Add Family Member';
                        document.getElementById('submitButton').innerHTML = '<i class="fas fa-save me-2"></i>Save Family Member';
                        document.getElementById('form_action').value = 'add';
                        document.getElementById('familyMemberForm').reset();
                        document.getElementById('family_id').value = '';
                    };
                    
                    // Listen for modal close events
                    var addModal = document.getElementById('addFamilyMemberModal');
                    if (addModal) {
                        addModal.addEventListener('hidden.bs.modal', resetForm);
                        // Also listen for manual close
                        addModal.addEventListener('click', function(e) {
                            if (e.target === this) {
                                hideModal('addFamilyMemberModal');
                                resetForm();
                            }
                        });
                    }
                    
                    // Close delete modal on backdrop click
                    var deleteModal = document.getElementById('deleteFamilyMemberModal');
                    if (deleteModal) {
                        deleteModal.addEventListener('click', function(e) {
                            if (e.target === this) {
                                hideModal('deleteFamilyMemberModal');
                            }
                        });
                    }
                });
            ]]>
            </script>

            <!-- Additional CSS for Family Members -->
            <style>
                .family-member-details {
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                }
                
                .detail-item {
                    display: flex;
                    align-items: center;
                    padding: 0.25rem 0;
                    font-size: 0.9rem;
                }
                
                .detail-item i {
                    color: #667eea;
                    width: 20px;
                }
                
                .dropdown-toggle::after {
                    display: none;
                }
                
                /* Dropdown menu styling */
                .dropdown-menu {
                    min-width: 8rem;
                    padding: 0.5rem 0;
                    margin: 0.125rem 0 0;
                    font-size: 0.875rem;
                    color: #212529;
                    text-align: left;
                    list-style: none;
                    background-color: #fff;
                    background-clip: padding-box;
                    border: 1px solid rgba(0,0,0,.15);
                    border-radius: 0.25rem;
                    box-shadow: 0 0.5rem 1rem rgba(0,0,0,.175);
                    position: absolute;
                    top: 100%;
                    right: 0;
                    z-index: 1000;
                    display: none;
                }
                
                .dropdown-menu.show,
                .dropdown-menu[style*="display: block"] {
                    display: block !important;
                }
                
                .dropdown-item {
                    display: block;
                    width: 100%;
                    padding: 0.25rem 1rem;
                    clear: both;
                    font-weight: 400;
                    color: #212529;
                    text-align: inherit;
                    text-decoration: none;
                    white-space: nowrap;
                    background-color: transparent;
                    border: 0;
                }
                
                .dropdown-item:hover,
                .dropdown-item:focus {
                    color: #16181b;
                    background-color: #e9ecef;
                }
                
                .dropdown-item.text-danger:hover {
                    background-color: #f8d7da;
                    color: #721c24;
                }
                
                .dropdown {
                    position: relative;
                }
                
                .modal-content {
                    border: none;
                    border-radius: 15px;
                    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
                }
                
                .modal-header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    color: white;
                    border-radius: 15px 15px 0 0;
                }
                
                .modal-header .btn-close {
                    filter: invert(1);
                }
                
                /* Manual modal fallback styles */
                .modal.show {
                    display: block !important;
                }
                
                .modal-backdrop {
                    position: fixed;
                    top: 0;
                    left: 0;
                    z-index: 1040;
                    width: 100vw;
                    height: 100vh;
                    background-color: rgba(0, 0, 0, 0.5);
                }
                
                .modal-open {
                    overflow: hidden;
                }
                
                /* Ensure modal appears above backdrop */
                .modal {
                    z-index: 1050;
                }
                
                /* Bootstrap compatibility */
                .modal-dialog {
                    position: relative;
                    width: auto;
                    margin: 0.5rem;
                    pointer-events: none;
                }
                
                @media (min-width: 576px) {
                    .modal-dialog {
                        max-width: 500px;
                        margin: 1.75rem auto;
                    }
                }
            </style>
        </t>
    </template>
</odoo>