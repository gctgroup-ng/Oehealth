<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_oeh_medical_category">
        <field name="name">intarvas</field>
        <field name="sequence">0</field>
        <field name="visible" eval="0"/>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_intarvas">
        <field name="name">intarvas</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_oeh_medical_category"/>
    </record>

    <record id="group_oeh_medical_physician" model="res.groups">
        <field name="name">Doctor / Therapist</field>
        <field name="privilege_id" ref="res_groups_privilege_intarvas"/>
    </record>

    <record id="group_oeh_medical_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="privilege_id" ref="res_groups_privilege_intarvas"/>
    </record>

    <record id="group_oeh_medical_manager" model="res.groups">
        <field name="name">Health Center Admin</field>
        <field name="privilege_id" ref="res_groups_privilege_intarvas"/>
        <field name="implied_ids" eval="[(4, ref('intarvas.group_oeh_medical_physician')),(4, ref('intarvas.group_oeh_medical_nurse'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[Command.link(ref('group_oeh_medical_manager'))]"/>
    </record>

    <record id="base.user_root" model="res.users">
        <field name="group_ids" eval="[Command.link(ref('group_oeh_medical_manager'))]"/>
    </record>

</odoo>

