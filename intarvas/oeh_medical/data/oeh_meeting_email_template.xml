<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="oeh_email_template_meeting_invitation" model="mail.template">
        <field name="name">Meeting Invitation: Send by email</field>
        <field name="model_id" ref="intarvas.model_oeh_medical_appointment"/>
        <field name="subject">Meeting Invitation # : {{object.name or 'n/a' }}</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="partner_to">{{object.partner_ids}}</field>
<!--        <field name="res_id"/>-->
        <field name="body_html" type="html">
            <div>
                <p>
                    Hello <t t-out="object.patient.name or ''">,</t>
                    <br/>
                    <br/>
                    <t t-out="object.patient.partner_id.name"/> invited you to the <t t-out="object.name"/> meeting.
                </p>
                <div style="text-align: left; margin: 16px 0px 16px 0px;">
<!--                    <a href="/web#/id=${object.id}/view_type=form/model=oeh.medical.appointment"-->
<!--                       style="padding: 5px 5px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">-->
<!--                        View-->
<!--                    </a>-->
                    <a t-attf-href="/web#id={{ object.id }}&amp;view_type=form&amp;model=oeh.medical.appointment&amp;cids=&amp;menu_id=223"
                       style="padding: 2px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px">
                        View
                    </a>
                </div>
                <table border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <!--                        % if not recurrent:-->
                        <td width="130px;">
                            <div style="border-top-left-radius: 3px; border-top-right-radius: 3px; font-size: 12px; border-collapse: separate; text-align: center; font-weight: bold; color: #ffffff; min-height: 18px; background-color: #875A7B; border: 1px solid #875A7B;">
                                <t t-out="object.get_interval('dayname', tz=object.partner_id.tz if not object.allday else None)"/>
                            </div>
                            <div style="font-size: 48px; min-height: auto; font-weight: bold; text-align: center; color: #5F5F5F; background-color: #F8F8F8; border: 1px solid #875A7B;">
                                <t t-out="object.get_interval('day', tz=object.partner_id.tz if not object.allday else None)"/>
                            </div>
                            <div style='font-size: 12px; text-align: center; font-weight: bold; color: #ffffff; background-color: #875A7B;'>
                                <t t-out="object.get_interval('month', tz=object.partner_id.tz if not object.allday else None)"/>
                            </div>
                            <div style="border-collapse: separate; color: #5F5F5F; text-align: center; font-size: 12px; border-bottom-right-radius: 3px; font-weight: bold; border: 1px solid #875A7B; border-bottom-left-radius: 3px;">
                                <t t-out="not object.allday and object.get_interval('time', tz=object.partner_id.tz) or ''"/>
                            </div>
                        </td>
                        <td width="20px;"/>
                        <!--                        % endif-->
                        <td style="padding-top: 5px;">
                            <p>
                                <strong>Details of the event</strong>
                            </p>
                            <ul>
                                <li>
                                    Attendees
                                    <ul>
                                        <li>
                                            <span style="margin-left:5px"><t t-out="object.patient.name"/></span>
                                        </li>
                                        <li>
                                            <span style="margin-left:5px"><t t-out="object.doctor.name"/></span>
                                        </li>
                                    </ul>
                                </li>
                                <li>
                                    Meeting URL
                                    <ul>
                                        <li>
                                            <span><t t-out="object.invitation_text"/></span>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </td>
                    </tr>
                </table>
                <br/>
                Thank you,
                <t t-if ="object.partner_id.user_id.signature">
                <br/>
                <t t-out="object.partner_id.user_id.signature or ''"/>
                </t>
            </div>
        </field>
    </record>

</odoo>