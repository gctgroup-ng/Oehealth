<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Chief Complaint Templates Data -->

        <!-- Common Cold/Flu Template -->
        <record id="complaint_template_cold_flu" model="oeh.medical.chief.complaint.template">
            <field name="name">Common Cold/Flu</field>
            <field name="description">Template for common cold and flu symptoms</field>
            <field name="active">True</field>
        </record>

        <record id="complaint_template_cold_flu_line1" model="oeh.medical.chief.complaint.template.line">
            <field name="template_id" ref="complaint_template_cold_flu"/>
            <field name="complaint_id" ref="complaint_2"/>  <!-- Cough -->
            <field name="frequency">daily</field>
            <field name="severity">moderate</field>
            <field name="days">3</field>
            <field name="duration">day</field>
        </record>

