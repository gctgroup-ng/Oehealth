<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- 24 Hour Reminder Email Template for Patient -->
        <record id="email_template_appointment_reminder_24h_patient" model="mail.template">
            <field name="name">Appointment Reminder - 24 Hours (Patient)</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="subject">Appointment Reminder - Tomorrow at {{ object.appointment_date.strftime('%I:%M %p') }}</field>
            <field name="email_from">{{ object.institution.email or user.email or '' }}</field>
            <field name="email_to">{{ object.patient.email or '' }}</field>
            <field name="lang">{{ object.patient.partner_id.lang or 'en_US' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin: 0px auto; background-color: #f8f9fa;">
        <tbody>
            <tr>
                <td style="padding: 40px 20px;">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; max-width: 600px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <tbody>
                            <!-- Header -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #2c5aa0; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 600;">
                                        🏥 Appointment Reminder
                                    </h1>
                                    <p style="margin: 10px 0 0 0; color: #e3f2fd; font-size: 16px;">
                                        Your appointment is tomorrow
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Content -->
                            <tr>
                                <td style="padding: 40px 30px;">
                                    <h2 style="margin: 0 0 20px 0; color: #333333; font-size: 24px; font-weight: 600;">
                                        Hello <t t-out="object.patient.name or ''"/>,
                                    </h2>
                                    
                                    <p style="margin: 0 0 25px 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        This is a friendly reminder that you have an appointment scheduled for <strong>tomorrow</strong>.
                                    </p>
                                    
                                    <!-- Appointment Details Card -->
                                    <div style="background-color: #f8f9fa; border-left: 4px solid #2c5aa0; padding: 20px; margin: 25px 0; border-radius: 4px;">
                                        <h3 style="margin: 0 0 15px 0; color: #2c5aa0; font-size: 18px; font-weight: 600;">
                                            📅 Appointment Details
                                        </h3>
                                        <table style="width: 100%; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333; width: 30%;">Date:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.appointment_date.strftime('%A, %B %d, %Y')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Time:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.appointment_date.strftime('%I:%M %p')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Doctor:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.doctor.name or ''"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Location:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.institution.name or 'Medical Center'"/></td>
                                            </tr>
                                            <t t-if="object.invitation_text">
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Meeting Link:</td>
                                                <td style="padding: 8px 0;">
                                                    <a t-attf-href="{{ object.invitation_text or '' }}" style="color: #2c5aa0; text-decoration: none; font-weight: 600;">
                                                        Join Online Meeting
                                                    </a>
                                                </td>
                                            </tr>
                                            </t>
                                        </table>
                                    </div>
                                    
                                    <!-- Preparation Tips -->
                                    <div style="background-color: #e8f5e8; border: 1px solid #c8e6c9; padding: 20px; margin: 25px 0; border-radius: 4px;">
                                        <h3 style="margin: 0 0 15px 0; color: #2e7d32; font-size: 16px; font-weight: 600;">
                                            💡 Preparation Tips
                                        </h3>
                                        <ul style="margin: 0; padding-left: 20px; color: #555555; line-height: 1.6;">
                                            <li>Please arrive 15 minutes early for check-in</li>
                                            <li>Bring a valid ID and insurance cards</li>
                                            <li>Bring any relevant medical records or medications</li>
                                            <li>Prepare a list of questions or concerns</li>
                                        </ul>
                                    </div>
                                    
                                    <p style="margin: 25px 0 0 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        If you need to reschedule or cancel your appointment, please contact us as soon as possible.
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Footer -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #f8f9fa; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
                                    <p style="margin: 0 0 10px 0; color: #777777; font-size: 14px;">
                                        <t t-out="object.institution.name or 'Medical Center'"/>
                                    </p>
                                    <t t-if="object.institution.street">
                                    <p style="margin: 0 0 10px 0; color: #777777; font-size: 14px;">
                                        <t t-out="object.institution.street or ''"/>
                                        <t t-if="object.institution.city">
                                        , <t t-out="object.institution.city or ''"/>
                                        </t>
                                    </p>
                                    </t>
                                    <t t-if="object.institution.phone">
                                    <p style="margin: 0; color: #777777; font-size: 14px;">
                                        📞 <t t-out="object.institution.phone or ''"/>
                                    </p>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

        <!-- 15 Minute Reminder Email Template for Patient -->
        <record id="email_template_appointment_reminder_15m_patient" model="mail.template">
            <field name="name">Appointment Reminder - 15 Minutes (Patient)</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="subject">Your appointment starts in 15 minutes!</field>
            <field name="email_from">{{ object.institution.email or user.email or '' }}</field>
            <field name="email_to">{{ object.patient.email or '' }}</field>
            <field name="lang">{{ object.patient.partner_id.lang or 'en_US' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin: 0px auto; background-color: #f8f9fa;">
        <tbody>
            <tr>
                <td style="padding: 40px 20px;">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; max-width: 600px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <tbody>
                            <!-- Header -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #ff6b35; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 600;">
                                        ⏰ Appointment Starting Soon!
                                    </h1>
                                    <p style="margin: 10px 0 0 0; color: #ffe4dc; font-size: 16px;">
                                        Your appointment starts in 15 minutes
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Content -->
                            <tr>
                                <td style="padding: 40px 30px;">
                                    <h2 style="margin: 0 0 20px 0; color: #333333; font-size: 24px; font-weight: 600;">
                                        Hello <t t-out="object.patient.name or ''"/>,
                                    </h2>
                                    
                                    <p style="margin: 0 0 25px 0; color: #555555; font-size: 18px; line-height: 1.6; font-weight: 600;">
                                        Your appointment with <t t-out="object.doctor.name or ''"/> starts in <span style="color: #ff6b35;">15 minutes</span>!
                                    </p>
                                    
                                    <!-- Quick Details -->
                                    <div style="background-color: #fff8f5; border: 2px solid #ff6b35; padding: 20px; margin: 25px 0; border-radius: 8px; text-align: center;">
                                        <p style="margin: 0; color: #ff6b35; font-size: 20px; font-weight: 600;">
                                            📍 <t t-out="object.appointment_date.strftime('%I:%M %p')"/> • <t t-out="object.institution.name or 'Medical Center'"/>
                                        </p>
                                    </div>
                                    
                                    <t t-if="object.invitation_text">
                                    <!-- Online Meeting Link -->
                                    <div style="text-align: center; margin: 30px 0;">
                                        <a t-attf-href="{{ object.invitation_text or '' }}" 
                                           style="display: inline-block; background-color: #2c5aa0; color: #ffffff; padding: 15px 30px; 
                                                  text-decoration: none; border-radius: 6px; font-size: 16px; font-weight: 600;">
                                            🎥 Join Online Meeting
                                        </a>
                                    </div>
                                    </t>
                                    <t t-else="">
                                    <!-- Physical Location -->
                                    <div style="background-color: #e3f2fd; border-left: 4px solid #2196f3; padding: 15px; margin: 20px 0;">
                                        <p style="margin: 0; color: #1976d2; font-size: 16px; font-weight: 600;">
                                            📍 Please head to <t t-out="object.institution.name or 'the medical center'"/> now
                                        </p>
                                    </div>
                                    </t>
                                    
                                    <p style="margin: 25px 0 0 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        We look forward to seeing you soon!
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Footer -->
                            <tr>
                                <td style="padding: 20px; text-align: center; background-color: #f8f9fa; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
                                    <t t-if="object.institution.phone">
                                    <p style="margin: 0; color: #777777; font-size: 14px;">
                                        Need help? Call us: <t t-out="object.institution.phone or ''"/>
                                    </p>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

        <!-- 24 Hour Reminder Email Template for Doctor -->
        <record id="email_template_appointment_reminder_24h_doctor" model="mail.template">
            <field name="name">Appointment Reminder - 24 Hours (Doctor)</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="subject">Appointment Reminder - Tomorrow with {{ object.patient.name or '' }}</field>
            <field name="email_from">{{ object.institution.email or user.email or '' }}</field>
            <field name="email_to">{{ object.doctor.work_email or '' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin: 0px auto; background-color: #f8f9fa;">
        <tbody>
            <tr>
                <td style="padding: 40px 20px;">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; max-width: 600px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <tbody>
                            <!-- Header -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #1e88e5; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600;">
                                        🩺 Appointment Reminder
                                    </h1>
                                    <p style="margin: 10px 0 0 0; color: #bbdefb; font-size: 16px;">
                                        Tomorrow's Schedule
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Content -->
                            <tr>
                                <td style="padding: 40px 30px;">
                                    <h2 style="margin: 0 0 20px 0; color: #333333; font-size: 20px; font-weight: 600;">
                                        <t t-out="object.doctor.name or ''"/>,
                                    </h2>
                                    
                                    <p style="margin: 0 0 25px 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        You have an appointment scheduled for tomorrow.
                                    </p>
                                    
                                    <!-- Patient Information -->
                                    <div style="background-color: #f8f9fa; border-left: 4px solid #1e88e5; padding: 20px; margin: 25px 0; border-radius: 4px;">
                                        <h3 style="margin: 0 0 15px 0; color: #1e88e5; font-size: 18px; font-weight: 600;">
                                            👤 Patient Information
                                        </h3>
                                        <table style="width: 100%; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333; width: 30%;">Patient:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.patient.name or ''"/></td>
                                            </tr>
                                            <t t-if="object.patient.age">
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Age:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.patient.age or ''"/> years</td>
                                            </tr>
                                            </t>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Date &amp; Time:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.appointment_date.strftime('%A, %B %d, %Y at %I:%M %p')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Duration:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.duration or ''"/> hours</td>
                                            </tr>
                                            <t t-if="object.urgency_level and object.urgency_level != 'Normal'">
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Urgency:</td>
                                                <td style="padding: 8px 0; color: #ff6b35; font-weight: 600;"><t t-out="object.urgency_level or ''"/></td>
                                            </tr>
                                            </t>
                                        </table>
                                    </div>
                                    
                                    <t t-if="object.comments">
                                    <div style="background-color: #fff3e0; border: 1px solid #ffb74d; padding: 15px; margin: 20px 0; border-radius: 4px;">
                                        <h4 style="margin: 0 0 10px 0; color: #f57c00; font-size: 16px;">📝 Comments:</h4>
                                        <p style="margin: 0; color: #555555; font-style: italic;"><t t-out="object.comments or ''"/></p>
                                    </div>
                                    </t>
                                </td>
                            </tr>
                            
                            <!-- Footer -->
                            <tr>
                                <td style="padding: 20px; text-align: center; background-color: #f8f9fa; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
                                    <p style="margin: 0; color: #777777; font-size: 14px;">
                                        intarvas Appointment System
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

        <!-- 15 Minute Reminder Email Template for Doctor -->
        <record id="email_template_appointment_reminder_15m_doctor" model="mail.template">
            <field name="name">Appointment Reminder - 15 Minutes (Doctor)</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="subject">Appointment in 15 minutes - {{ object.patient.name or '' }}</field>
            <field name="email_from">{{ object.institution.email or user.email or '' }}</field>
            <field name="email_to">{{ object.doctor.work_email or '' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin: 0px auto; background-color: #f8f9fa;">
        <tbody>
            <tr>
                <td style="padding: 20px;">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; max-width: 500px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <tbody>
                            <!-- Header -->
                            <tr>
                                <td style="padding: 25px; text-align: center; background-color: #4caf50; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; color: #ffffff; font-size: 20px; font-weight: 600;">
                                        ⏱️ Next Appointment
                                    </h1>
                                </td>
                            </tr>
                            
                            <!-- Content -->
                            <tr>
                                <td style="padding: 30px 25px;">
                                    <div style="text-align: center; margin-bottom: 20px;">
                                        <h2 style="margin: 0; color: #333333; font-size: 18px;">
                                            <t t-out="object.patient.name or ''"/>
                                        </h2>
                                        <p style="margin: 5px 0 0 0; color: #4caf50; font-size: 16px; font-weight: 600;">
                                            Starting in 15 minutes
                                        </p>
                                    </div>
                                    
                                    <t t-if="object.invitation_text">
                                    <div style="text-align: center; margin: 20px 0;">
                                        <a t-attf-href="{{ object.invitation_text or '' }}" 
                                           style="display: inline-block; background-color: #1e88e5; color: #ffffff; padding: 12px 24px; 
                                                  text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 600;">
                                            Join Meeting
                                        </a>
                                    </div>
                                    </t>
                                    
                                    <t t-if="object.urgency_level and object.urgency_level != 'Normal'">
                                    <div style="background-color: #ffebee; border: 1px solid #f44336; padding: 10px; border-radius: 4px; text-align: center;">
                                        <p style="margin: 0; color: #d32f2f; font-weight: 600; font-size: 14px;">
                                            ⚠️ <t t-out="object.urgency_level or ''"/>
                                        </p>
                                    </div>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

        <!-- Appointment Accepted Email Template -->
        <record id="email_template_appointment_accepted" model="mail.template">
            <field name="name">Appointment Accepted</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="subject">✅ Your appointment has been confirmed</field>
            <field name="email_from">{{ object.institution.email or user.email or '' }}</field>
            <field name="email_to">{{ object.patient.email or '' }}</field>
            <field name="lang">{{ object.patient.partner_id.lang or 'en_US' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin: 0px auto; background-color: #f8f9fa;">
        <tbody>
            <tr>
                <td style="padding: 40px 20px;">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; max-width: 600px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <tbody>
                            <!-- Header -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #4caf50; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 600;">
                                        ✅ Appointment Confirmed!
                                    </h1>
                                    <p style="margin: 10px 0 0 0; color: #c8e6c9; font-size: 16px;">
                                        <t t-out="object.doctor.name or ''"/> has accepted your appointment
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Content -->
                            <tr>
                                <td style="padding: 40px 30px;">
                                    <h2 style="margin: 0 0 20px 0; color: #333333; font-size: 24px; font-weight: 600;">
                                        Great news, <t t-out="object.patient.name or ''"/>!
                                    </h2>
                                    
                                    <p style="margin: 0 0 25px 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        Your appointment request has been <strong style="color: #4caf50;">confirmed</strong> by <t t-out="object.doctor.name or ''"/>.
                                    </p>
                                    
                                    <!-- Confirmed Appointment Details -->
                                    <div style="background-color: #e8f5e8; border-left: 4px solid #4caf50; padding: 20px; margin: 25px 0; border-radius: 4px;">
                                        <h3 style="margin: 0 0 15px 0; color: #2e7d32; font-size: 18px; font-weight: 600;">
                                            📅 Confirmed Appointment
                                        </h3>
                                        <table style="width: 100%; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333; width: 30%;">Date:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.appointment_date.strftime('%A, %B %d, %Y')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Time:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.appointment_date.strftime('%I:%M %p')"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Doctor:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.doctor.name or ''"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-weight: 600; color: #333333;">Location:</td>
                                                <td style="padding: 8px 0; color: #555555;"><t t-out="object.institution.name or 'Medical Center'"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    
                                    <t t-if="object.doctor_response_notes">
                                    <div style="background-color: #f3e5f5; border: 1px solid #ba68c8; padding: 15px; margin: 20px 0; border-radius: 4px;">
                                        <h4 style="margin: 0 0 10px 0; color: #7b1fa2; font-size: 16px;">💬 Message from <t t-out="object.doctor.name or ''"/>:</h4>
                                        <p style="margin: 0; color: #555555; font-style: italic;"><t t-out="object.doctor_response_notes or ''"/></p>
                                    </div>
                                    </t>
                                    
                                    <p style="margin: 25px 0 0 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        We'll send you reminder notifications before your appointment. If you need to make any changes, 
                                        please contact us as soon as possible.
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Footer -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #f8f9fa; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
                                    <p style="margin: 0 0 10px 0; color: #777777; font-size: 14px;">
                                        <t t-out="object.institution.name or 'Medical Center'"/>
                                    </p>
                                    <t t-if="object.institution.phone">
                                    <p style="margin: 0; color: #777777; font-size: 14px;">
                                        📞 <t t-out="object.institution.phone or ''"/>
                                    </p>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

        <!-- Appointment Rejected Email Template -->
        <record id="email_template_appointment_rejected" model="mail.template">
            <field name="name">Appointment Rejected</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="subject">Appointment Update - Alternative Options Available</field>
            <field name="email_from">{{ object.institution.email or user.email or '' }}</field>
            <field name="email_to">{{ object.patient.email or '' }}</field>
            <field name="lang">{{ object.patient.partner_id.lang or 'en_US' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin: 0px auto; background-color: #f8f9fa;">
        <tbody>
            <tr>
                <td style="padding: 40px 20px;">
                    <table cellpadding="0" cellspacing="0" style="width: 100%; max-width: 600px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <tbody>
                            <!-- Header -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #ff9800; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 600;">
                                        📅 Appointment Update
                                    </h1>
                                    <p style="margin: 10px 0 0 0; color: #ffe0b2; font-size: 16px;">
                                        We need to reschedule your appointment
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Content -->
                            <tr>
                                <td style="padding: 40px 30px;">
                                    <h2 style="margin: 0 0 20px 0; color: #333333; font-size: 24px; font-weight: 600;">
                                        Hello <t t-out="object.patient.name or ''"/>,
                                    </h2>
                                    
                                    <p style="margin: 0 0 25px 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        We regret to inform you that <t t-out="object.doctor.name or ''"/> is unable to see you at your
                                        scheduled time on <t t-out="object.appointment_date.strftime('%A, %B %d, %Y at %I:%M %p')"/>.
                                    </p>
                                    
                                    <!-- Reason -->
                                    <t t-if="object.rejection_reason">
                                    <div style="background-color: #fff3e0; border-left: 4px solid #ff9800; padding: 15px; margin: 20px 0; border-radius: 4px;">
                                        <h4 style="margin: 0 0 10px 0; color: #f57c00; font-size: 16px;">📋 Reason:</h4>
                                        <p style="margin: 0; color: #555555;">
                                            <t t-if="object.rejection_reason == 'schedule_conflict'">
                                                Schedule conflict
                                            </t>
                                            <t t-elif="object.rejection_reason == 'emergency'">
                                                Medical emergency
                                            </t>
                                            <t t-elif="object.rejection_reason == 'personal_leave'">
                                                Personal leave
                                            </t>
                                            <t t-elif="object.rejection_reason == 'patient_requirements'">
                                                Patient requirements not met
                                            </t>
                                            <t t-else="">
                                                Other circumstances
                                            </t>
                                        </p>
                                        <t t-if="object.rejection_notes">
                                        <p style="margin: 10px 0 0 0; color: #555555; font-style: italic;">
                                            <t t-out="object.rejection_notes or ''"/>
                                        </p>
                                        </t>
                                    </div>
                                    </t>
                                    
                                    <!-- Alternative Suggestion (from wizard context) -->
                                    <t t-if="ctx.get('suggest_alternative') and ctx.get('alternative_date')">
                                    <div style="background-color: #e8f5e8; border: 1px solid #4caf50; padding: 20px; margin: 25px 0; border-radius: 8px;">
                                        <h3 style="margin: 0 0 15px 0; color: #2e7d32; font-size: 18px; font-weight: 600;">
                                            🕐 Alternative Time Suggested
                                        </h3>
                                        <p style="margin: 0 0 10px 0; color: #555555; font-size: 16px;">
                                            <strong>New suggested time:</strong> <t t-out="ctx.get('alternative_date').strftime('%A, %B %d, %Y at %I:%M %p') if ctx.get('alternative_date') else 'To be confirmed'"/>
                                        </p>
                                        <t t-if="ctx.get('alternative_notes')">
                                        <p style="margin: 10px 0 0 0; color: #555555; font-style: italic;">
                                            <t t-out="ctx.get('alternative_notes') or ''"/>
                                        </p>
                                        </t>
                                    </div>
                                    </t>
                                    
                                    <div style="background-color: #e3f2fd; border: 1px solid #2196f3; padding: 20px; margin: 25px 0; border-radius: 4px;">
                                        <h3 style="margin: 0 0 15px 0; color: #1976d2; font-size: 18px; font-weight: 600;">
                                            📞 Next Steps
                                        </h3>
                                        <p style="margin: 0 0 10px 0; color: #555555; line-height: 1.6;">
                                            Please contact our office to schedule a new appointment:
                                        </p>
                                        <t t-if="object.institution.phone">
                                        <p style="margin: 0; color: #1976d2; font-size: 16px; font-weight: 600;">
                                            📞 <t t-out="object.institution.phone or ''"/>
                                        </p>
                                        </t>
                                    </div>
                                    
                                    <p style="margin: 25px 0 0 0; color: #555555; font-size: 16px; line-height: 1.6;">
                                        We sincerely apologize for any inconvenience and appreciate your understanding. 
                                        We're committed to providing you with the best possible care.
                                    </p>
                                </td>
                            </tr>
                            
                            <!-- Footer -->
                            <tr>
                                <td style="padding: 30px; text-align: center; background-color: #f8f9fa; border-radius: 0 0 8px 8px; border-top: 1px solid #e0e0e0;">
                                    <p style="margin: 0 0 10px 0; color: #777777; font-size: 14px;">
                                        <t t-out="object.institution.name or 'Medical Center'"/>
                                    </p>
                                    <t t-if="object.institution.phone">
                                    <p style="margin: 0; color: #777777; font-size: 14px;">
                                        📞 <t t-out="object.institution.phone or ''"/>
                                    </p>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

    </data>
</odoo>