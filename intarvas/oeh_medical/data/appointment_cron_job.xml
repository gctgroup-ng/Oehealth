<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Appointment Reminder Cron Job -->
        <record id="ir_cron_appointment_reminders" model="ir.cron">
            <field name="name">Send Appointment Reminders</field>
            <field name="model_id" ref="model_oeh_medical_appointment"/>
            <field name="state">code</field>
            <field name="code">model.send_appointment_reminders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>