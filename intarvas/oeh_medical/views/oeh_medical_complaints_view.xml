<?xml version="1.0" ?>
<odoo>
        <data>

            <!-- Chief Complaints -->

             <record id="oeh_medical_complaints_form" model="ir.ui.view">
                <field name="name">Chief Complaints</field>
                <field name="model">oeh.medical.complaints</field>
                <field name="arch" type="xml">
                    <form string='Chief Complaints'>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </form>
                </field>
            </record>

            <record model="ir.ui.view" id="oeh_medical_complaints_tree">
                <field name="name">Chief Complaints</field>
                <field name="model">oeh.medical.complaints</field>
                <field name="arch" type="xml">
                    <list string='Chief Complaints' editable="bottom">
                        <field name="name"/>
                        <field name="active" widget="boolean_toggle"/>
                    </list>
                </field>
            </record>

             <record id="view_oeh_medical_complaints_filter" model="ir.ui.view">
                <field name="name">Chief Complaints Search</field>
                <field name="model">oeh.medical.complaints</field>
			    <field name="arch" type="xml">
                    <search string="Chief Complaints">
                        <field name="name"/>
                        <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                        <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
				    </search>
                </field>
            </record>

            <record id="oeh_medical_complaints_action_tree" model="ir.actions.act_window">
                    <field name="name">Chief Complaints</field>
                    <field name="res_model">oeh.medical.complaints</field>
                    <field name="view_mode">list,form</field>
                    <field name="help" type="html">
                      <p class="o_view_nocontent_smiling_face">
                        Click to add a new chief complaint.
                      </p>
                    </field>
            </record>

            <menuitem action="oeh_medical_complaints_action_tree" id="oeh_medical_complaints_conf_list" parent="oeh_medical_conf_patient" sequence="2"/>

        </data>
</odoo>