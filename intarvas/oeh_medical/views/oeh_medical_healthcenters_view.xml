            <record model="ir.ui.view" id="oeh_medical_healthcenters_ward_view_clean">
                <field name="name">Wards</field>
                <field name="model">oeh.medical.health.center.ward</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                    <form string="Wards">
                        <header>
                            <field name="state" widget="statusbar" statusbar_visible="Beds Available,Full"/>
                        </header>
                        <sheet>
                            <div class="oe_button_box" name="button_box">
                                <button type="action" class="oe_stat_button"
                                        name="%(oeh_medical_healthcenters_bed_action_tree_clean)d"
                                        context="{'default_ward': id, 'default_institution': institution, 'default_building': building}"
                                        icon="fa-list"
                                        groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager,intarvas.group_oeh_medical_nurse">
                                    <field string="Beds" name="bed_count" widget="statinfo"/>
                                </button>
                            </div>
                            <div class="oe_left" style="width: 500px;">
                                <div class="oe_title" style="width: 390px;">
                                    <label class="oe_edit_only" for="name" string="Ward Name"/>
                                    <h1><field name="name" class="oe_inline"/></h1>
                                </div>
                            </div>

                            <group class="col-12">
                                <group class="col-6">
                                    <field name="institution"/>
                                    <field name="floor"/>
                                    <field name="private"/>
                                </group>
                                <group class="col-6">
                                    <field name="building" domain="[('institution', '=', institution)]" context="{'default_institution': institution}"/>
                                    <field name="gender"/>
                                    <field name="bio_hazard"/>
                                </group>
                            </group>
                            <group string="Facilities">
                                <group>
                                    <field name="telephone"/>
                                    <field name="private_bathroom"/>
                                    <field name="tv"/>
                                    <field name="refrigerator"/>
                                </group>
                                <group>
                                    <field name="ac"/>
                                    <field name="guest_sofa"/>
                                    <field name="internet"/>
                                    <field name="microwave"/>
                                </group>
                            </group>
                            <group string="Extra Information">
                                <field name="info" colspan="2" nolabel="1"/>
                            </group>
                        </sheet>
                    </form>
                </field>
            </record>



