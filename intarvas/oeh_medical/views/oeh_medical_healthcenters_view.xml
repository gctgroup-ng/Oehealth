            <!-- Health Centers -->
            <record model="ir.ui.view" id="oeh_medical_healthcenters_view">
                <field name="name">Health Centers</field>
                <field name="model">oeh.medical.health.center</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                    <form string="Health Centers">
                        <sheet>
                            <div class="oe_button_box" name="button_box">
                                <button type="action"
                                        class="oe_stat_button"
                                        name="%(oeh_medical_healthcenters_building_action_tree)d"
                                        context="{'search_default_institution': id, 'default_institution': id}"
                                        icon="fa-building-o"
                                        groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager,intarvas.group_oeh_medical_nurse">
                                    <span>Buildings</span>
                                </button>
                            </div>
                            <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image": "image_128", "size": [90, 90]}'/>
                            <div class="oe_title">
                                <label for="name" string="Health Center Name" class="oe_edit_only"/>
                                <h1>
                                    <field name="name" required="1"/>
                                </h1>
                                <label for="health_center_type" class="oe_edit_only"/>
                                <field name="health_center_type" required="1"/>
                            </div><br/>
                            <group name="company">
                                <field name="company_id" required="1"/>
                            </group>
                            <group>
                                <group>
                                    <label for="street" string="Address"/>
                                    <div class="o_address_format">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                    </div>
                                    <field name="website" widget="url" placeholder="e.g. www.odoo.com"/>
                                </group>
                                <group>
                                    <field name="phone" placeholder="e.g. +32.81.81.37.00" widget="phone"/>
                                    <field name="email" widget="email"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Buildings" name="buildings">
                                    <field name="building_ids" nolabel="1">
                                        <list string="Buildings">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="ward_count"/>
                                            <field name="bed_count"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Wards" name="wards">
                                    <field name="ward_ids" nolabel="1">
                                        <list string="Wards">
                                            <field name="name"/>
                                            <field name="building"/>
                                            <field name="floor"/>
                                            <field name="gender"/>
                                            <field name="state"/>
                                            <field name="bed_count"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Accommodations" name="accommodations">
                                    <field name="bed_ids" nolabel="1">
                                        <list string="Accommodations">
                                            <field name="name"/>
                                            <field name="accommodation_type"/>
                                            <field name="building"/>
                                            <field name="ward"/>
                                            <field name="bed_type"/>
                                            <field name="state"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Extra Information">
                                    <field name="info" nolabel="1"/>
                                </page>
                            </notebook>
                        </sheet>
                    </form>
                </field>
            </record>


