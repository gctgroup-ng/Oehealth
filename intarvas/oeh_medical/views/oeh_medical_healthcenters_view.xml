            <!-- Beds -->

            <record model="ir.ui.view" id="oeh_medical_healthcenters_bed_view_clean">
                <field name="name">Accommodations</field>
                <field name="model">oeh.medical.health.center.beds</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                    <form string="Beds">
                        <header>
                            <field name="state" widget="statusbar" statusbar_visible="Free,Reserved,Occupied,Not Available"/>
                        </header>
                        <sheet>
                            <div class="oe_title">
                                <label class="oe_edit_only" for="name" string="Bed Name"/>
                                <h1>
                                    <field name="name" class="oe_inline"/>
                                </h1>
                                <label for="accommodation_type" class="oe_edit_only"/>
                                <field name="accommodation_type" required="1" widget="radio"/>
                            </div>
                            <group>
                                <group>
                                    <field name="institution"/>
                                    <field name="telephone_number"/>
                                    <field name="list_price" string="Accommodation Charge (per day)"/>
                                </group>
                                <group>
                                    <field name="bed_type" invisible="accommodation_type != 'bed'" required="accommodation_type == 'bed'"/>
                                    <field name="building" domain="[('institution','=',institution)]" context="{'default_institution': institution}"/>
                                    <field name="ward"/>
                                </group>
                            </group>
                            <group string="Extra Information"/>
                            <field name="info" nolabel="1"/>
                            <!-- </group> -->
                        </sheet>
                    </form>
                </field>
            </record>

            <record id="oeh_medical_healthcenters_bed_tree_clean" model="ir.ui.view">
                <field name="name">Accommodations</field>
                <field name="model">oeh.medical.health.center.beds</field>
                <field name="arch" type="xml">
                    <list string='Beds'>
                        <field name="name"/>
                        <field name="accommodation_type"/>
                        <field name="ward"/>
                        <field name="institution"/>
                        <field name="building"/>
                        <field name="bed_type"/>
                        <field name="telephone_number"/>
                        <field name="state"/>
                    </list>
                </field>
            </record>

            <record id="view_medical_healthcenters_bed_filter_clean" model="ir.ui.view">
                <field name="name">Accommodation Search</field>
                <field name="model">oeh.medical.health.center.beds</field>
                <field name="arch" type="xml">
                    <search string="Beds">
                        <field name="name"/>
                        <field name="accommodation_type"/>
                        <field name="ward"/>
                        <field name="building"/>
                        <field name="bed_type"/>
                        <field name="telephone_number"/>
                        <separator/>
                        <group>
                            <filter string="Accommodation Types" name="group_accommodation_type" context="{'group_by': 'accommodation_type'}"/>
                            <filter string="Wards" name="group_ward" context="{'group_by':'ward'}" />
                            <filter string="Health Centers" name="group_health_centers" context="{'group_by':'institution'}" />
                            <filter string="Buildings" name="group_building" context="{'group_by':'building'}" />
                            <filter string="States" name="group_state"  context="{'group_by':'state'}" />
                        </group>
                    </search>
                </field>
            </record>

            <record id="oeh_medical_healthcenters_bed_action_tree_clean" model="ir.actions.act_window">
                    <field name="name">Accommodations</field>
                    <field name="res_model">oeh.medical.health.center.beds</field>
                    <field name="view_mode">list,form</field>
                    <field name="help" type="html">
                      <p class="o_view_nocontent_smiling_face">
                        Register new bed or room.
                      </p><p>
                        With intarvas accommodation screen, you can configure your rooms &amp; beds to assign your patients
                      </p>
                    </field>
            </record>

