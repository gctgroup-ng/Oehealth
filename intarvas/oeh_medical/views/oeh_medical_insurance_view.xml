            <!-- Insurance -->

            <record model="ir.ui.view" id="oeh_medical_insurance_view">
                <field name="name">Insurances</field>
                <field name="model">oeh.medical.insurance</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                    <form string="Insurances">
                        <header>
                            <button name="make_active" confirm="Are you sure you want to mark insurance as Active?" invisible="state != 'Draft'" string="Make Active" type="object" class="oe_highlight"/>
                            <field name="state" widget="statusbar" statusbar_visible="Draft,Active,Expired"/>
                        </header>
                        <sheet>
                            <div class="oe_left" style="width: 500px;">
                                <div class="oe_title" style="width: 390px;">
                                    <label class="oe_edit_only" for="name" string="Insurer Name"/>
                                    <h1><field name="name" class="oe_inline" required="1"/></h1>
                                </div>
                            </div>
                            <group class="col-12">
                                <group class="col-6">
                                    <field name="ins_no"/>
                                    <field name="start_date"/>
                                    <field name="ins_type"/>
                                </group>
                                <group class="col-6">
                                    <field name="patient" widget="many2one_avatar_patient"/>
                                    <field name="exp_date"/>
                                </group>
                            </group>
                            <group string="Extra Information"/>
                            <field name="info" nolabel="1"/>
                            <!-- </group> -->
                        </sheet>
                    </form>
                </field>
            </record>

            <record model="ir.ui.view" id="oeh_medical_insurance_tree">
                <field name="name">Insurances</field>
                <field name="model">oeh.medical.insurance</field>
<!--                <field name="type">tree</field>-->
                <field name="arch" type="xml">
                    <list string='Insurances'>
                        <field name="name"/>
                        <field name="ins_no"/>
                        <field name="patient"/>
                        <field name="ins_type"/>
                        <field name="start_date"/>
                        <field name="exp_date"/>
                        <field name="state"/>
                    </list>
                </field>
            </record>

             <record id="view_oeh_medical_insurance_filter" model="ir.ui.view">
                <field name="name">Insurance Search</field>
                <field name="model">oeh.medical.insurance</field>
			    <field name="arch" type="xml">
                    <search string="Insurances">
                        <field name="name"/>
                        <field name="ins_no"/>
                        <field name="patient"/>
                        <separator/>
                        <group>
                            <filter string="Name" name="group_name" context="{'group_by':'name'}" />
                            <filter string="Patient" name="group_patient" context="{'group_by':'patient'}" />
                            <filter string="Type" name="group_type" context="{'group_by':'ins_type'}" />
                            <filter string="State" name="group_state" context="{'group_by':'state'}" />
                        </group>
				    </search>
                </field>
            </record>

            <record id="oeh_medical_insurance_action_tree" model="ir.actions.act_window">
                    <field name="name">Insurances</field>
                    <field name="res_model">oeh.medical.insurance</field>
                    <field name="view_mode">list,form</field>
                    <field name="help" type="html">
                      <p class="o_view_nocontent_smiling_face">
                        Click to add a new insurance records.
                      </p>
                    </field>
            </record>

        </data>
</odoo>