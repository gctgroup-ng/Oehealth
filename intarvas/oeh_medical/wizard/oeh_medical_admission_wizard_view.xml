<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_oeh_medical_admission_wizard" model="ir.ui.view">
            <field name="name">Patient Admission Wizard</field>
            <field name="model">oeh.medical.admission.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Admit Patient">
                    <group>
                        <group>
                            <field name="patient_id" readonly="1" widget="many2one_avatar_patient"/>
                            <field name="appointment_id" invisible="1"/>
                            <field name="scheduled_date"/>
                            <field name="admission_reason"/>
                        </group>
                        <group>
                            <field name="institution" options="{'no_create': True}"/>
                            <field name="admission_type"/>
                            <field name="ward" options="{'no_create': True}"/>
                            <field name="bed" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_admit_patient" string="Admit Patient" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>