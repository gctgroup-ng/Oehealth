<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Appointment Rejection Wizard Form View -->
        <record id="view_appointment_rejection_wizard_form" model="ir.ui.view">
            <field name="name">oeh.appointment.rejection.wizard.form</field>
            <field name="model">oeh.appointment.rejection.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Appointment">
                    <sheet>
                        <div class="oe_title">
                            <h1>Reject Appointment</h1>
                        </div>
                        <group>
                            <field name="appointment_id" readonly="1"/>
                            <field name="rejection_reason" required="1"/>
                            <field name="rejection_notes" placeholder="Please provide details about why you are rejecting this appointment..."/>
                        </group>
                        
                        <group string="Suggest Alternative" invisible="not suggest_alternative">
                            <field name="suggest_alternative"/>
                            <field name="alternative_date" required="suggest_alternative" invisible="not suggest_alternative"/>
                            <field name="alternative_notes" invisible="not suggest_alternative" placeholder="Explain why this alternative time works better..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm_rejection" string="Reject Appointment" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Appointment Rejection Wizard Action -->
        <record id="action_appointment_rejection_wizard" model="ir.actions.act_window">
            <field name="name">Reject Appointment</field>
            <field name="res_model">oeh.appointment.rejection.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_oeh_medical_appointment"/>
        </record>

    </data>
</odoo>