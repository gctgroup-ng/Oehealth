    <record id="oeh_medical_injury_examination_result_view" model="ir.ui.view">
        <field name="name">Injury Examination Procedures</field>
        <field name="model">oeh.medical.injury.examination</field>
        <field name="inherit_id" ref="intarvas.oeh_medical_injury_examination_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='print_injury_examination_report']" position="before">
                <button
                    name="%(action_oeh_medical_injury_result_wizard)d"
                    string="Record Emergency Result"
                    type="action"
                    class="oe_highlight"
                    confirm="Are you sure you want to store the result?"/>
            </xpath>
        </field>
    </record>



