"                                        <h4 style=\"margin: 0 0 10px 0; color: #f57c00; font-size: 16px;\">📝 Comments:</h4>\n"
"                                        <p style=\"margin: 0; color: #555555; font-style: italic;\"><t t-out=\"object.comments or ''\"/></p>\n"
