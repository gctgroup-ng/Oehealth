"                    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; max-width: 600px; margin: 0px auto; background-color: #ffffff; border-radius: 8px; box-"
"shadow: 0 2px 8px rgba(0,0,0,0.1);\">\n"
"                        <tbody>\n"
"                            <!-- Header -->\n"
"                            <tr>\n"
"                                <td style=\"padding: 30px; text-align: center; background-color: #1e88e5; border-radius: 8px 8px 0 0;\">\n"
