#. module: intarvas
#: model:mail.template,body_html:intarvas.email_template_appointment_reminder_24h_patient
msgid ""
"<div style=\"margin: 0px; padding: 0px; background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\">\n"
