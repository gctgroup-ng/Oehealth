<?xml version="1.0"?>
<openerp>
    <data>

        <!-- RCRI -->
        <record id="oeh_medical_surgery_rcri_physician" model="ir.rule">
            <field name="name">Access all the rcri</field>
            <field name="model_id" ref="model_oeh_medical_surgery_rcri"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oeh_medical_surgery_rcri_admin" model="ir.rule">
            <field name="name">Access all the rcri</field>
            <field name="model_id" ref="model_oeh_medical_surgery_rcri"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_manager'))]"/>
        </record>

        <!-- Surgeries -->

        <record id="oeh_medical_surgery_physician" model="ir.rule">
            <field name="name">Each physician can see only own surgeries</field>
            <field name="model_id" ref="model_oeh_medical_surgery"/>
            <field name="domain_force">['|', ('surgeon', '=', False), ('surgeon.oeh_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oeh_medical_surgery_admin" model="ir.rule">
            <field name="name">Access all the surgeries</field>
            <field name="model_id" ref="model_oeh_medical_surgery"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_manager'))]"/>
        </record>


        <!-- Surgical Management -->

        <record model='ir.ui.menu' id='oeh_medical_healthcenters_ot_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_manager')])]"/>
        </record>

        <record model='ir.ui.menu' id='oeh_medical_surgery_rcri_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager'),ref('intarvas.group_oeh_medical_nurse')])]"/>
        </record>

        <record model='ir.ui.menu' id='oeh_medical_surgery_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager'),ref('intarvas.group_oeh_medical_nurse')])]"/>
        </record>


    </data>
</openerp>