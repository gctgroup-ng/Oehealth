<?xml version="1.0" ?>
    <odoo>
        <data>

            <!-- Surgery Management -->
		    <menuitem name="Surgeries" id="oeh_medical_surgery_menu" parent="intarvas.oeh_medical_menu" sequence="25"/>


            <!-- Revised Cardiac Risk Index Management -->

            <record id="view_oeh_medical_surgery_rcri" model="ir.ui.view">
                <field name="name">RCRI Search</field>
                <field name="model">oeh.medical.surgery.rcri</field>
                <field name="type">search</field>
                <field name="arch" type="xml">
                    <search string="Search Revised Cardiac Risk Index">
                        <separator orientation="vertical"/>
                            <field name="name" select="1"/>
                            <field name="patient" string="Patient" select="1"/>
                            <field name="doctor" string="Doctor"/>
                        <newline/>
                        <group>
                            <filter name="group_patient" string="Patient" context="{'group_by':'patient'}"/>
                            <filter name="group_doctor" string="Doctor" context="{'group_by':'doctor'}"/>
                        </group>
                    </search>
                </field>
            </record>

            <record model="ir.ui.view" id="oeh_medical_surgery_rcri_view">
                <field name="name">Revised Cardiac Risk Index</field>
                <field name="model">oeh.medical.surgery.rcri</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                <form string="Revised Cardiac Risk Index">
                    <sheet>
                        <div class="oe_title">
                           <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <label for="patient" class="oe_edit_only"/>
                            <field name="patient"/>
                            <group>
                                <p class="oe_grey" colspan="2">
                                    Points 0: Class I Very Low (0.4% complications)<br/>
                                    Points 1: Class II Low (0.9% complications)<br/>
                                    Points 2: Class III Moderate (6.6% complications)<br/>
                                    Points 3 or more : Class IV High (>11% complications)
                                </p>
                            </group>
                        </div>
                        <group>
                            <group>
                                <field name="rcri_date"/>
                            </group>
                            <group>
                                <field name="doctor" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="rcri_high_risk_surgery" on_change="on_change_with_rcri(rcri_high_risk_surgery, rcri_ischemic_history, rcri_congestive_history, rcri_diabetes_history, rcri_cerebrovascular_history, rcri_kidney_history)"/>
                                <field name="rcri_congestive_history" on_change="on_change_with_rcri(rcri_high_risk_surgery, rcri_ischemic_history, rcri_congestive_history, rcri_diabetes_history, rcri_cerebrovascular_history, rcri_kidney_history)"/>
                                <field name="rcri_cerebrovascular_history" on_change="on_change_with_rcri(rcri_high_risk_surgery, rcri_ischemic_history, rcri_congestive_history, rcri_diabetes_history, rcri_cerebrovascular_history, rcri_kidney_history)"/>
                            </group>
                            <group>
                                <field name="rcri_ischemic_history" on_change="on_change_with_rcri(rcri_high_risk_surgery, rcri_ischemic_history, rcri_congestive_history, rcri_diabetes_history, rcri_cerebrovascular_history, rcri_kidney_history)"/>
                                <field name="rcri_diabetes_history" on_change="on_change_with_rcri(rcri_high_risk_surgery, rcri_ischemic_history, rcri_congestive_history, rcri_diabetes_history, rcri_cerebrovascular_history, rcri_kidney_history)"/>
                                <field name="rcri_kidney_history" on_change="on_change_with_rcri(rcri_high_risk_surgery, rcri_ischemic_history, rcri_congestive_history, rcri_diabetes_history, rcri_cerebrovascular_history, rcri_kidney_history)"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="rcri_total"/>
                            </group>
                            <group>
                                <field name="rcri_class"/>
                            </group>
                        </group>
                    </sheet>
                    </form>
                </field>
            </record>

            <record model="ir.ui.view" id="oeh_medical_surgery_rcri_tree">
                <field name="name">Revised Cardiac Risk Index</field>
                <field name="model">oeh.medical.surgery.rcri</field>
<!--                <field name="type">tree</field>-->
                    <field name="arch" type="xml">
                        <list string='Revised Cardiac Risk Index Information'>
                            <field name="name"/>
                            <field name="patient"/>
                            <field name="doctor"/>
                            <field name="rcri_date"/>
                        </list>
                    </field>
            </record>

            <record id="oeh_medical_surgery_rcri_action_tree" model="ir.actions.act_window">
                    <field name="name">Revised Cardiac Risk Index</field>
                    <field name="res_model">oeh.medical.surgery.rcri</field>
                    <field name="view_mode">list,form</field>
                    <field name="help" type="html">
                      <p class="o_view_nocontent_smiling_face">
                        Click to register a new Revised Cardiac Risk Index (RCRI).
                      </p>
                    </field>
            </record>

            <menuitem action="oeh_medical_surgery_rcri_action_tree" parent="oeh_medical_surgery_menu"
                      id="oeh_medical_surgery_rcri_list" sequence="5"/>

            <!-- Surgical Management -->

            <record id="view_oeh_medical_surgery" model="ir.ui.view">
                <field name="name">Surgeries</field>
                <field name="model">oeh.medical.surgery</field>
                <field name="type">search</field>
                <field name="arch" type="xml">
                    <search string="Search Surgeries">
                        <field name="name" select="1"/>
                        <field name="patient" string="Patient" select="1"/>
                        <field name="surgeon" string="Surgeon" select="1"/>
                        <field name="anesthetist" string="Anesthetist" select="1"/>
                        <newline/>
                        <group>
                            <filter name="group_patient" string="Patient" context="{'group_by':'patient'}"/>
                            <filter name="group_surgeon" string="Surgeon" context="{'group_by':'surgeon'}"/>
                            <filter name="group_anesthetist" string="Anesthetist" context="{'group_by':'anesthetist'}"/>
                            <filter name="group_states" string="States" context="{'group_by':'state'}"/>
                        </group>
                    </search>
                </field>
            </record>

            <record model="ir.ui.view" id="oeh_medical_surgery_view">
                <field name="name">Surgeries</field>
                <field name="model">oeh.medical.surgery</field>
                <field name="type">form</field>
                <field name="arch" type="xml">
                <form string="Surgeries">
                    <header>
                        <button confirm="Are you sure you want to confirm the surgery detail?" name="action_surgery_confirm" invisible="state!='Draft'" string="Confirm Surgery" type="object" class="oe_highlight" groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager"/>
                        <button confirm="Are you sure you want to start surgery?" name="action_surgery_start" invisible="state!='Confirmed'" string="Start Surgery" type="object" class="oe_highlight" groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager"/>
                        <button confirm="Are you sure you want to end surgery?" name="action_surgery_end" invisible="state!='In Progress'" string="End Surgery" type="object" class="oe_highlight" groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager"/>
                        <button confirm="Are you sure you want to sign the surgery record?" name="action_surgery_sign" invisible="state!='Invoice'" string="Sign &amp; Archive" type="object" class="oe_highlight" groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager"/>
                        <button confirm="Are you sure you want to create invoice" name="set_to_invoiced" invisible="state!='Done'" string="Create Invoice" type="object" class="oe_highlight"/>
                        <button confirm="Are you sure you want to cancel the surgery?" name="action_surgery_cancel" invisible="state not in ['Draft','Confirmed']" string="Cancel Surgery" type="object" groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager"/>
                        <button confirm="Are you sure you want to set surgery record in Draft state?" name="action_surgery_set_to_draft" invisible="state!='Cancelled'" string="Set To Draft" type="object" class="oe_highlight" groups="intarvas.group_oeh_medical_physician,intarvas.group_oeh_medical_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="Draft,Confirmed,In Progress,Done,Invoice,Signed,Cancelled" statusbar_colors='{"Draft":"blue","Confirmed":"green","In Progress":"green","Done":"grey","Signed":"grey","Cancelled":"red"}'/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                           <button class="oe_stat_button" name="action_view_invoice" type="object"
                                string="View Invoice" icon="fa-pencil-square-o" invisible="not move_id"/>
                        </div>
                        <div class="oe_title">
                           <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="patient" readonly="state!='Draft'"/>
                            </group>
                            <group>
                                <field name="gender" required="1" readonly="state!='Draft'"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="computed_age" readonly="1"/>
                                <field name="surgery_length" widget="float_time" invisible="state in ['Draft','Confirmed','Cancelled','In Progress']" readonly="state!='Draft'"/>
                            </group>
                            <group>
                                <field name="surgery_date" readonly="state!='Draft'"/>
                                <field name="surgery_end_date" invisible="state in ['Draft','Confirmed','Cancelled','In Progress']" readonly="state!='Draft'"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="classification" readonly="state!='Draft'"/>
                                <field name="institution" options="{'no_create': True}" readonly="state!='Draft'"/>
                                <field name="building" domain="[('institution','=',institution)]" options="{'no_create': True}" readonly="state!='Draft'"/>
                                <field name="operating_room" domain="[('building','=',building),('state','=','Free')]" options="{'no_create': True}" readonly="state!='Draft'"/>
                            </group>
                            <group>
                                <field name="surgery_type"/>
                                <field name="pathology" readonly="state!='Draft'"/>
                                <field name="surgeon" readonly="state!='Draft'"/>
                                <field name="anesthetist" readonly="state!='Draft'"/>
                                <field name="signed_by" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Operation Info">
                                <group string="Patient Surgical Risk Assessment">
                                    <group>
                                        <field name="preop_asa" readonly="state!='Draft'"/>
                                        <field name="preop_mallampati" readonly="state!='Draft'"/>
                                    </group>
                                    <group>
                                        <field name="preop_rcri" readonly="state!='Draft'"/>
                                        <field name="surgical_wound" readonly="state!='Draft'"/>
                                    </group>
                                </group>
                                <group string="Preoperative Checklist">
                                    <group>
                                        <field name="preop_bleeding_risk" readonly="state!='Draft'"/>
                                        <field name="preop_site_marking" readonly="state!='Draft'"/>
                                        <field name="preop_sterility" readonly="state!='Draft'"/>
                                    </group>
                                    <group>
                                        <field name="preop_oximeter" readonly="state!='Draft'"/>
                                        <field name="preop_antibiotics" readonly="state!='Draft'"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Procedures &amp; Supplies">
                                <group>
                                    <field name="procedures" widget="many2many_tags" options="{'no_create': True}" readonly="state!='In Progress'"/>
                                </group>
                                <group string="Supplies">
                                    <field name="supplies" nolabel="1" colspan="2" readonly="state not in ['Confirmed','In Progress']">
                                        <list string="Supplies" editable="bottom">
                                            <field name="supply"/>
                                            <field name="qty"/>
                                            <field name="qty_used"/>
                                            <field name="notes"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Team Members">
                                <field name="surgery_team" nolabel="1" readonly="state!='Draft'">
                                    <list string="Team Members" editable="bottom">
                                        <field name="team_member"/>
                                        <field name="role"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Information">
                                <group string="Description">
                                    <field name="description" colspan="2" nolabel="1" readonly="state not in ['Draft','Confirmed','In Progress']"/>
                                </group>
                                <group string="Anesthesia Report">
                                    <field name="anesthesia_report" colspan="2" nolabel="1" readonly="state not in ['Draft','Confirmed','In Progress']"/>
                                </group>
                                <group string="Extra Info">
                                    <field name="info" colspan="2" nolabel="1" readonly="state not in ['Draft','Confirmed','In Progress']"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                    </form>
                </field>
            </record>

            <record model="ir.ui.view" id="oeh_medical_surgery_tree">
                <field name="name">Surgeries</field>
                <field name="model">oeh.medical.surgery</field>
<!--                <field name="type">tree</field>-->
                    <field name="arch" type="xml">
                        <list string='Surgeries' decoration-muted="state in ('Done','Signed')" decoration-info="state=='Draft'" decoration-success="state in ('Confirmed','In Progress')" decoration-danger="state=='Cancelled'">
                            <field name="name"/>
                            <field name="patient"/>
                            <field name="surgery_date"/>
                            <field name="classification"/>
                            <field name="surgeon"/>
                            <field name="anesthetist"/>
                            <field name="institution"/>
                            <field name="state" widget="badge" decoration-muted="state in ('Done','Signed')" decoration-info="state=='Draft'" decoration-success="state in ('Confirmed','In Progress')" decoration-danger="state=='Cancelled'"/>
                        </list>
                    </field>
            </record>

            <record id="oeh_medical_surgery_action_tree" model="ir.actions.act_window">
                    <field name="name">Surgeries</field>
                    <field name="res_model">oeh.medical.surgery</field>
                    <field name="view_mode">list,form</field>
                    <field name="help" type="html">
                      <p class="o_view_nocontent_smiling_face">
                        Click to add a new surgery.
                      </p><p>
                        intarvas surgery screen will allow you to record complete details of all the surgeries;
                      </p>
                    </field>
            </record>

            <menuitem action="oeh_medical_surgery_action_tree" parent="oeh_medical_surgery_menu"  id="oeh_medical_surgery_list" sequence="10"/>

            <!-- Inheriting Patient screen to display patient's surgeries -->

            <record id="oeh_medical_patient_surgery_view" model="ir.ui.view">
                <field name="name">Patient</field>
                <field name="model">oeh.medical.patient</field>
                <field name="inherit_id" ref="intarvas.oeh_medical_patient_view"/>
                <field name="arch" type="xml">
                    <xpath expr="//notebook[last()]" position="inside">
                         <page string="Surgeries" name="surgeries">
                            <field name="pediatrics_surgery_ids" readonly="1"/>
                        </page>
                    </xpath>
                </field>
            </record>

        </data>
    </odoo>