<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--        Laboratory Menu Rights-->

    <record id="group_oeh_medical_lab_technician" model="res.groups">
        <field name="name">Lab Technician</field>
        <field name="privilege_id" ref="intarvas.res_groups_privilege_intarvas"/>
    </record>

    <record id="intarvas.group_oeh_medical_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('intarvas_lab.group_oeh_medical_lab_technician'))]"/>
    </record>

    <record model='ir.ui.menu' id='oeh_medical_lab_technician'>
        <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager')])]"/>
    </record>

    <record model='ir.ui.menu' id='oeh_medical_lab_units_conf_list'>
        <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager')])]"/>
    </record>

    <record model='ir.ui.menu' id='oeh_medical_lab_test_types_conf_list'>
        <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager')])]"/>
    </record>

    <record model='ir.ui.menu' id='oeh_medical_lab_test_conf_list'>
        <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager')])]"/>
    </record>

    <record model="ir.ui.menu" id='oeh_medical_labtest_department_menu'>
        <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager')])]"/>
    </record>
</odoo>