<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Lab Tests -->

        <record id="oeh_medical_lab_test_physician" model="ir.rule">
            <field name="name">Each physician can see only own lab tests</field>
            <field name="model_id" ref="model_oeh_medical_lab_test"/>
            <field name="domain_force">['|', ('pathologist', '=', False), ('pathologist.oeh_user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oeh_medical_lab_test_admin" model="ir.rule">
            <field name="name">Access all the lab tests</field>
            <field name="model_id" ref="model_oeh_medical_lab_test"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_manager'))]"/>
        </record>

         <record id="oeh_medical_lab_test_technician" model="ir.rule">
            <field name="name">Each Lab Technician can see only own lab tests</field>
            <field name="model_id" ref="model_oeh_medical_lab_test"/>
            <field name="domain_force">['|', ('lab_technician_id', '=', False), ('lab_technician_id.oeh_user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('intarvas_lab.group_oeh_medical_lab_technician'))]"/>
        </record>

    </data>
</odoo>