<?xml version="1.0" ?>
<odoo>
    <data>

        <!-- Lab Test Template Form View -->
        <record id="oeh_lab_test_template_form" model="ir.ui.view">
            <field name="name">Lab Test Template</field>
            <field name="model">oeh.medical.lab.test.template</field>
            <field name="arch" type="xml">
                <form string='Lab Test Template'>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lab Test Lines">
                                <field name="lab_test_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="test_type_id"/>
                                        <field name="urgency"/>
                                        <field name="info"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Lab Test Template Tree View -->
        <record id="oeh_lab_test_template_tree" model="ir.ui.view">
            <field name="name">Lab Test Template</field>
            <field name="model">oeh.medical.lab.test.template</field>
            <field name="arch" type="xml">
                <list string='Lab Test Templates'>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Lab Test Template Action -->
        <record id="oeh_lab_test_template_action" model="ir.actions.act_window">
            <field name="name">Lab Test Templates</field>
            <field name="res_model">oeh.medical.lab.test.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to add a new lab test template.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem action="oeh_lab_test_template_action"
                  id="oeh_lab_test_template_menu"
                  parent="intarvas.oeh_medical_templates_menu"
                  sequence="2"/>

    </data>
</odoo>