<?xml version="1.0" ?>
<odoo>
    <data>

        <!-- Lab Sample Type -->

        <record model="ir.ui.view" id="oeh_medical_lab_samples_tree">
            <field name="name">Lab Samples</field>
            <field name="model">oeh.medical.lab.samples</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string='Lab Samples' editable="bottom">
                    <sheet>
                        <group>
                            <field name="sample_type"/>
                            <field name="comments"/>
                            <field name="samples_ids" string='Lab Tests' widget="many2many_checkboxes"/>
                        </group>
                    </sheet>
                    <footer>
                        <!--                        <button name="action_submit" type="object" class="oe_highlight" string="Submit"/>-->
                    </footer>
                </form>
            </field>
        </record>


        <record id="oeh_medical_lab_samples_action_tree" model="ir.actions.act_window">
            <field name="name">Lab Samples</field>
            <field name="res_model">oeh.medical.lab.samples</field>
            <field name="view_mode">form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click to add a new sample type
                </p>
            </field>
        </record>

    </data>
</odoo>