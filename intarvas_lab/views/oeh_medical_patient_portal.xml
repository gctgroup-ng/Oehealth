                                        <!--                                                   groups="intarvas.group_oeh_medical_physician"/>-->
                                        <!--                                            </a>-->
                                        <!--                                        </div>-->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <t t-set="completed_labtest"
                           t-value="request.env['oeh.medical.lab.test'].sudo().search([('patient', '=', patient.id), ('state', '=', 'Completed')])"/>
                        <p t-if="completed_labtest" class="mt16 mb16" style="color:gray;">
                            Completed
                        </p>
                        <div t-if="completed_labtest" t-foreach="completed_labtest"
                             t-as="lab" class="mb32 ml-2">
                            <div class="row">
                                <div class="column text-left font_patient ml-2" style="width: 70%;">
                                    <p class="mb0 font-weight-bold">
                                        <t t-esc="lab.name"/>
                                    </p>
                                    <p class="mb0">
                                        <span class="label_color font-weight-bold">Date:</span>
                                        <span t-field="lab.date_requested"/>
                                    </p>
                                    <p class="mb0">
                                        <span class="label_color font-weight-bold">Lab Tests:</span>
                                        <t t-set="lab_count" t-value="0"/>
                                        <t t-foreach="lab.lab_test_type_ids" t-as="types">
                                            <t t-set="lab_count" t-value="lab_count + 1"/>
                                            <t t-if="len(lab.lab_test_type_ids) > lab_count">
                                                <span t-field="types.name"/>
