                                               title="Completed" role="img"></i>
                                            <span class="d-none d-md-inline">Completed</span>
                                        </span>
                                    </t>
                                </div>
                                <div class="column text-right" style="width: 5%;">
                                    <div class="row">
                                        <div class="column edit_family" style="width: 90%;">
                                            <a t-attf-href="/patient/portal/labtest-report/#{lab.id}">
                                                <i class="fa fa-print link_patient font_patient"
                                                   style="border:none;"/>
                                            </a>
                                        </div>
                                        <!--                                        <div class="column edit_family" style="width:30%;">-->
                                        <!--                                            <a t-attf-href="#">-->
                                        <!--                                                <i class="fa fa-pencil link_patient font_patient"-->
                                        <!--                                                   style="border:none;"-->
                                        <!--                                                   groups="intarvas.group_oeh_medical_physician"/>-->
                                        <!--                                            </a>-->
                                        <!--                                        </div>-->
