<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="patient_lab_details_form" inherit_id="intarvas_patient_portal.patient_detail_form"
              name="Patient Lab Detail Form">
        <xpath expr="//div[hasclass('appointment_show')]" position="after">
            <div class="card mb-3">
                <h6 class="card-header" style="border:none;background-color:white !important;">
                    <div class="row">
                        <div class="column text-left font_patient" style="width: 50%;">
                            <i class="fa fa-address-book padding_patient"/>Lab Requests
                        </div>
                        <!-- <p class="card-text mb0" t-if="user_id">user<t t-esc="user_id.id"/></p>
                        <p class="card-text mb0" t-if="patient">patient<t t-esc="patient.oeh_patient_user_id.id"/></p> -->
                        <div class="column text-right" style="width: 50%;">
                            <!-- <t t-if="user_id.id == patient.oeh_patient_user_id.id"> -->
                            <a t-attf-href="/patient/portal/#{patient.id}/lab_requests"
                               groups="intarvas.group_oeh_medical_physician">
                                <button class="fa fa-plus link_patient font_patient"
                                        style="border:none;" type="button">View All
                                </button>
                            </a>
                            <!-- </t> -->
                        </div>
                    </div>
                </h6>
                <div class="card-body">
                    <t t-set="lab_req"
                       t-value="request.env['oeh.medical.lab.request'].sudo().search([('patient', '=', patient.id)])"/>
                    <p class="card-text font_patient" t-if="not lab_req">
                        <i class="fa fa-plus-circle"/> &amp;nbsp;
                        <span>List out of all your lab requests.</span>
                    </p>
                    <t t-if="lab_req" t-foreach="lab_req" t-as="lab">
                        <p class="card-text font_patient " t-if="lab">
                            <div class="row">
                                <div class="column text-left font_patient ml-2" style="width: 70%;">
                                    <p class="mb0 font-weight-bold">
                                        <t t-esc="lab.name"/>
                                    </p>
                                    <p class="mb0">
                                        <span class="label_color font-weight-bold">Date:</span>
                                        <span t-field="lab.date_requested"/>
                                    </p>
                                    <p class="mb0">
                                        <span class="label_color font-weight-bold">Ordered Lab Tests:</span>
                                        <t t-set="lab_count" t-value="0"/>
                                        <t t-foreach="lab.lab_test_ids" t-as="types">
                                            <t t-set="lab_count" t-value="lab_count + 1"/>
                                            <t t-if="len(lab.lab_test_ids) > lab_count">
                                                <span t-field="types.name"/>
                                                ,
                                            </t>
                                            <t t-else="">
                                                <span t-field="types.name"/>
                                            </t>
                                        </t>
                                    </p>
                                    <p class="mb0">
                                        <span class="label_color font-weight-bold">Tests Charge:</span>
                                        <span t-esc="request.env.user.company_id.currency_id.symbol"/>
                                        <span t-field="lab.total"/>
                                    </p>
                                </div>
                                <div class="column text-left font_patient tx_status"
                                     style="width: 20%;">
                                    <t t-if="lab.state == 'Draft'">
                                        <span class="badge badge-pill badge-light">
                                            <i class="fa fa-fw fa-clock-o" aria-label="Draft"
                                               title="Draft" role="img"></i>
                                            <span class="d-none d-md-inline">Draft</span>
                                        </span>
                                    </t>
                                    <t t-if="lab.state == 'Sample Taken'">
                                        <span class="badge badge-pill badge-info">
                                            <i class="fa fa-fw fa-clock-o" aria-label="Sample Taken"
                                               title="Sample Taken" role="img"></i>
                                            <span class="d-none d-md-inline">Sample Taken</span>
                                        </span>
                                    </t>
                                    <t t-if="lab.state == 'Invoiced'">
                                        <span class="badge badge-pill" style="background-color:lightgray;">
                                            <i class="fa fa-fw fa-check" aria-label="Invoiced"
                                               title="Invoiced" role="img"></i>
                                            <span class="d-none d-md-inline">Invoiced</span>
                                        </span>
                                    </t>
                                    <t t-if="lab.state == 'Pushed For Testing'">
                                        <span class="badge badge-pill badge-success">
                                            <i class="fa fa-fw fa-check" aria-label="Pushed For Testing"
                                               title="Pushed For Testing" role="img"></i>
                                            <span class="d-none d-md-inline">Pushed For Testing</span>
                                        </span>
                                    </t>
                                </div>

                                <!--                                <div class="column text-right" style="width:2%;margin-left:303px;">-->
                                <!--                                    <div class="row">-->
                                <!--                                        <div class="column edit_family" style="width:50%;">-->
                                <!--                                            <a t-attf-href="/patient/portal/#{patient.id}/family/#{family.id}">-->
                                <!--                                                <i class="fa fa-pencil link_patient font_patient"-->
                                <!--                                                   style="border:none;"-->
                                <!--                                                   groups="intarvas.group_oeh_medical_physician"/>-->
                                <!--                                            </a>-->
                                <!--                                        </div>-->
                                <!--                                        <div class="column remove_family" style="width:50%;">-->
                                <!--                                            <a t-attf-href="/patient/portal/family/#{family.id}/remove">-->
                                <!--                                                <i class="fa fa-trash link_patient font_patient"-->
                                <!--                                                   style="border:none;"-->
                                <!--                                                   groups="intarvas.group_oeh_medical_physician"/>-->
                                <!--                                            </a>-->
                                <!--                                        </div>-->
                                <!--                                    </div>-->
                                <!--                                </div>-->
                            </div>
                            <!--                            </div>-->
                            <!--                        </t>-->
                        </p>
                    </t>
                </div>
            </div>


            <div class="card mb-3">
                <h6 class="card-header" style="border:none;background-color:white !important;">
                    <div class="row">
                        <div class="column text-left font_patient" style="width: 50%;">
