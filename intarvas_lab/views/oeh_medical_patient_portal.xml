                                            <span t-field="lab.lab_request"/>
                                        </t>
                                    </p>

                                </div>
                                <div class="column text-left font_patient tx_status"
                                     style="width: 20%;">
                                    <t t-if="lab.state == 'Draft'">
                                        <span class="badge badge-pill badge-light">
                                            <i class="fa fa-fw fa-clock-o" aria-label="Draft"
