<?xml version="1.0"?>
<openerp>
    <data>

        <!-- Pediatrics System Checklist -->

        <record id="oeh_medical_pediatrics_psc_physician" model="ir.rule">
            <field name="name">Access all the psc</field>
            <field name="model_id" ref="model_oeh_medical_pediatrics_psc"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oeh_medical_pediatrics_psc_admin" model="ir.rule">
            <field name="name">Access all the psc</field>
            <field name="model_id" ref="model_oeh_medical_pediatrics_psc"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('intarvas.group_oeh_medical_manager'))]"/>
        </record>

         <!-- Pediatrics Management -->

        <record model='ir.ui.menu' id='oeh_medical_newborn_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager'),ref('intarvas.group_oeh_medical_nurse')])]"/>
        </record>

        <record model='ir.ui.menu' id='oeh_medical_pediatrics_growth_chart_list'>
            <field name="group_ids" eval="[Command.set([ref('intarvas.group_oeh_medical_physician'), ref('intarvas.group_oeh_medical_manager'),ref('intarvas.group_oeh_medical_nurse')])]"/>
        </record>

    </data>
</openerp>